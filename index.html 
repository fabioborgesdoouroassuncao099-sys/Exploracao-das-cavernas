    ctx.strokeStyle = 'rgba(60,32,10,0.65)';
    ctx.lineWidth = 0.7;
    for (let i = -1; i <= 1; i += 2){
      ctx.beginPath();
      ctx.moveTo(2, i * 0.9);
      ctx.quadraticCurveTo(13, i * 1.6, 24, i * 0.7);
      ctx.stroke();
    }
    ctx.strokeStyle = 'rgba(255,220,180,0.55)';
    ctx.lineWidth = 0.9;
    ctx.beginPath();
    ctx.moveTo(3, -0.8);
    ctx.lineTo(24, -0.8);
    ctx.stroke();

    ctx.fillStyle = '#5a6478';
    ctx.beginPath();
    ctx.ellipse(25, 0, 2.2, 3, 0, 0, 7);
    ctx.fill();
    ctx.fillStyle = '#b8c3d5';
    ctx.beginPath();
    ctx.ellipse(25, -0.6, 1.4, 2, 0, 0, 7);
    ctx.fill();

    ctx.shadowColor = '#e0f0ff';
    ctx.shadowBlur = 14;

    ctx.strokeStyle = '#3a4458';
    ctx.lineWidth = 7;
    ctx.beginPath();
    ctx.moveTo(25, -11);
    ctx.quadraticCurveTo(36, 0, 25, 11);
    ctx.stroke();

    const steelGrad = ctx.createLinearGradient(25, -11, 36, 11);
    steelGrad.addColorStop(0, '#ffffff');
    steelGrad.addColorStop(0.4, '#c8d6ea');
    steelGrad.addColorStop(0.75, '#8a98b0');
    steelGrad.addColorStop(1, '#4e586e');
    ctx.strokeStyle = steelGrad;
    ctx.lineWidth = 5.5;
    ctx.beginPath();
    ctx.moveTo(25, -11);
    ctx.quadraticCurveTo(36, 0, 25, 11);
    ctx.stroke();

    ctx.strokeStyle = 'rgba(255,255,255,0.95)';
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(26, -10);
    ctx.quadraticCurveTo(34, -4, 34, 0);
    ctx.stroke();

    ctx.strokeStyle = 'rgba(30,38,52,0.7)';
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(26, 10);
    ctx.quadraticCurveTo(35, 4, 35, 0);
    ctx.stroke();

    ctx.fillStyle = '#e8eef7';
    ctx.shadowColor = '#ffffff';
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.moveTo(24, -11);
    ctx.lineTo(20, -14);
    ctx.lineTo(25, -8);
    ctx.closePath();
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(24, 11);
    ctx.lineTo(20, 14);
    ctx.lineTo(25, 8);
    ctx.closePath();
    ctx.fill();

    ctx.shadowBlur = 0;
    ctx.fillStyle = 'rgba(255,255,255,0.95)';
    ctx.beginPath();
    ctx.arc(31, -5, 1.4, 0, 7);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(33, 1, 1, 0, 7);
    ctx.fill();

    if (Math.random() < 0.5){
      spawnParticles(
        p.x + p.w/2 + p.facing * 40,
        p.y + p.h/2 - 4 + rand(-6, 6),
        '#fff3c0', 1, 60, 0.25, PT.SPARK, { size:1.4, grav:400 }
      );
    }

    ctx.restore();
  }

  ctx.restore();

  if (p.shieldGlow > 0.02){
    drawShield();
  }

  ctx.save();
  ctx.globalCompositeOperation = 'lighter';
  const lx = p.x + p.w/2, ly = p.y + p.h/2;
  const lightR = 220 + p.shieldGlow * 60;
  const lgrad = ctx.createRadialGradient(lx, ly, 10, lx, ly, lightR);
  lgrad.addColorStop(0, 'rgba(140,190,255,0.18)');
  lgrad.addColorStop(0.5, 'rgba(90,140,220,0.08)');
  lgrad.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = lgrad;
  ctx.beginPath();
  ctx.arc(lx, ly, lightR, 0, 7);
  ctx.fill();
  ctx.restore();
}

/* =========================================================
   ESCUDO
========================================================= */
function drawShield(){
  const p = player;
  const cx = p.x + p.w/2, cy = p.y + p.h/2;
  const dir = p.facing;
  const glow = p.shieldGlow;
  const intensity = 0.75 + 0.25 * Math.sin(time * 10);
  const alpha = 0.55 * glow * intensity;

  ctx.save();

  const grad = ctx.createRadialGradient(cx + dir * 18, cy, 10, cx + dir * 18, cy, 60);
  grad.addColorStop(0, `rgba(180,240,255,${alpha * 0.95})`);
  grad.addColorStop(0.4, `rgba(90,180,255,${alpha * 0.55})`);
  grad.addColorStop(0.75, `rgba(60,120,220,${alpha * 0.2})`);
  grad.addColorStop(1, 'rgba(60,120,220,0)');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.arc(cx + dir * 18, cy, 60, 0, 7);
  ctx.fill();

  const discGrad = ctx.createRadialGradient(cx + dir * 14, cy, 8, cx + dir * 14, cy, 44);
  discGrad.addColorStop(0, `rgba(200,250,255,${0.28 * glow})`);
  discGrad.addColorStop(0.7, `rgba(90,180,255,${0.18 * glow})`);
  discGrad.addColorStop(1, `rgba(60,120,220,0)`);
  ctx.fillStyle = discGrad;
  ctx.beginPath();
  ctx.arc(cx + dir * 14, cy, 44, 0, 7);
  ctx.fill();

  const startA = dir > 0 ? -1.18 : Math.PI - 1.18;
  const endA = dir > 0 ? 1.18 : Math.PI + 1.18;
  const anticlock = dir < 0;

  ctx.globalAlpha = 0.95 * glow;
  ctx.strokeStyle = '#aef4ff';
  ctx.lineWidth = 3.4;
  ctx.shadowColor = '#8ef0ff';
  ctx.shadowBlur = 24;
  ctx.beginPath();
  ctx.arc(cx + dir * 12, cy, 42, startA, endA, anticlock);
  ctx.stroke();

  ctx.strokeStyle = '#ffffff';
  ctx.lineWidth = 1.6;
  ctx.shadowBlur = 18;
  ctx.beginPath();
  ctx.arc(cx + dir * 12, cy, 36, startA * 0.92, endA * 0.92, anticlock);
  ctx.stroke();

  ctx.strokeStyle = 'rgba(140,220,255,0.55)';
  ctx.lineWidth = 1;
  ctx.shadowBlur = 12;
  ctx.beginPath();
  ctx.arc(cx + dir * 12, cy, 48, startA * 0.95, endA * 0.95, anticlock);
  ctx.stroke();

  ctx.shadowBlur = 10;
  ctx.shadowColor = '#8ef0ff';
  ctx.lineWidth = 1.4;
  ctx.globalAlpha = 0.85 * glow;

  for (let i = -2; i <= 2; i++){
    const a = dir > 0 ? i * 0.42 : Math.PI - i * 0.42;
    const hx = cx + dir * 12 + Math.cos(a) * 42;
    const hy = cy + Math.sin(a) * 42;
    const hexR = 5.5;
    ctx.strokeStyle = 'rgba(180,240,255,0.9)';
    ctx.beginPath();
    for (let k = 0; k < 6; k++){
      const ha = k * Math.PI / 3 + time * 0.8;
      const hxx = hx + Math.cos(ha) * hexR;
      const hyy = hy + Math.sin(ha) * hexR;
      if (k === 0) ctx.moveTo(hxx, hyy);
      else ctx.lineTo(hxx, hyy);
    }
    ctx.closePath();
    ctx.stroke();

    ctx.fillStyle = `rgba(140,220,255,${0.35 * glow})`;
    ctx.beginPath();
    for (let k = 0; k < 6; k++){
      const ha = k * Math.PI / 3 + time * 0.8;
      const hxx = hx + Math.cos(ha) * (hexR - 1.6);
      const hyy = hy + Math.sin(ha) * (hexR - 1.6);
      if (k === 0) ctx.moveTo(hxx, hyy);
      else ctx.lineTo(hxx, hyy);
    }
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(hx, hy, 1.2, 0, 7);
    ctx.fill();
  }

  ctx.globalAlpha = 0.35 * glow;
  ctx.strokeStyle = 'rgba(200,240,255,0.6)';
  ctx.lineWidth = 0.9;
  ctx.shadowBlur = 8;
  for (let i = 0; i < 6; i++){
    const yOff = -40 + i * 16;
    const a1 = dir > 0 ? -1.1 : Math.PI - 1.1;
    const a2 = dir > 0 ? 1.1 : Math.PI + 1.1;
    ctx.beginPath();
    for (let t = 0; t <= 1; t += 0.05){
      const ang = a1 + (a2 - a1) * t;
      const rx = cx + dir * 12 + Math.cos(ang) * (42 + yOff * 0.08);
      const ry = cy + Math.sin(ang) * (42 + yOff * 0.08);
      if (t === 0) ctx.moveTo(rx, ry);
      else ctx.lineTo(rx, ry);
    }
    ctx.stroke();
  }

  ctx.globalAlpha = 0.7 * glow;
  const fresnel = ctx.createRadialGradient(cx + dir * 36, cy, 2, cx + dir * 36, cy, 14);
  fresnel.addColorStop(0, 'rgba(255,255,255,0.9)');
  fresnel.addColorStop(0.5, 'rgba(180,240,255,0.5)');
  fresnel.addColorStop(1, 'rgba(140,220,255,0)');
  ctx.fillStyle = fresnel;
  ctx.beginPath();
  ctx.arc(cx + dir * 36, cy, 14, 0, 7);
  ctx.fill();

  if (Math.random() < 0.35){
    const a = Math.random() * Math.PI * 2;
    const r = 30 + Math.random() * 15;
    const px = cx + dir * 12 + Math.cos(a) * r;
    const py = cy + Math.sin(a) * r;
    spawnParticles(px, py, '#8ef0ff', 1, 15, 0.5, PT.EMBER, { size:1.4, grav:-30, vx: dir * 30 });
  }

  ctx.restore();
  ctx.shadowBlur = 0;
  ctx.globalAlpha = 1;
}

/* =========================================================
   AMBIENTE
========================================================= */
function drawAmbient(){
  ctx.save();
  for (const a of ambient){
    const flick = 0.6 + 0.4 * Math.sin(time * 1.8 + a.phase);
    ctx.globalAlpha = a.alpha * flick;
    ctx.fillStyle = `hsl(${a.hue}, 80%, 80%)`;
    ctx.shadowColor = `hsl(${a.hue}, 90%, 70%)`;
    ctx.shadowBlur = 6;
    ctx.beginPath();
    ctx.arc(a.x, a.y, a.size, 0, 7);
    ctx.fill();
  }
  ctx.restore();
  ctx.globalAlpha = 1;
  ctx.shadowBlur = 0;

  ctx.save();
  ctx.fillStyle = 'rgba(150,200,255,0.55)';
  ctx.shadowColor = '#8ec8ff';
  ctx.shadowBlur = 6;
  for (const d of drips){
    if (d.life < 2.4 && d.vy > 0){
      const sx = d.x - cam.x;
      const sy = d.y - cam.y;
      if (sx < -20 || sx > W + 20) continue;
      ctx.beginPath();
      ctx.ellipse(sx, sy, 1.6, 5, 0, 0, 7);
      ctx.fill();
    }
  }
  ctx.restore();
  ctx.shadowBlur = 0;
}

/* =========================================================
   RENDER PRINCIPAL
========================================================= */
function render(){
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.clearRect(0, 0, W, H);

  let sx = 0, sy = 0;
  if (shake.t > 0){
    const m = shake.m * shake.t;
    sx = rand(-m, m);
    sy = rand(-m, m);
  }

  drawBackground();

  ctx.save();
  ctx.translate(-cam.x * 0.08, -cam.y * 0.06);
  drawFarCave();
  ctx.restore();

  ctx.save();
  ctx.translate(-cam.x * 0.22, -cam.y * 0.14);
  drawMidCave();
  ctx.restore();

  ctx.save();
  ctx.translate(-Math.round(cam.x) + sx, -Math.round(cam.y) + sy);

  drawDecor();
  drawPlatforms();
  drawOres();
  drawSkeletons();
  drawBolts();
  drawPlayer();
  drawParticles();

  ctx.restore();

  drawFloaters();
  drawAmbient();

  const vg = ctx.createRadialGradient(W/2, H/2, Math.min(W,H) * 0.28, W/2, H/2, Math.max(W,H) * 0.82);
  vg.addColorStop(0, 'rgba(0,0,0,0)');
  vg.addColorStop(0.65, 'rgba(0,0,0,0.35)');
  vg.addColorStop(1, 'rgba(0,0,0,0.85)');
  ctx.fillStyle = vg;
  ctx.fillRect(0, 0, W, H);

  if (player.hp <= 2 && gameState === 'play'){
    const pulse = 0.5 + 0.5 * Math.sin(time * 5);
    ctx.fillStyle = `rgba(255,30,50,${0.08 + 0.07 * pulse})`;
    ctx.fillRect(0, 0, W, H);
  }

  if (flash.t > 0){
    ctx.fillStyle = flash.c;
    ctx.globalAlpha = Math.min(0.4, flash.m * flash.t);
    ctx.fillRect(0, 0, W, H);
    ctx.globalAlpha = 1;
  }

  ctx.save();
  ctx.globalCompositeOperation = 'overlay';
  const cg = ctx.createRadialGradient(W/2, H/2, Math.min(W,H) * 0.4, W/2, H/2, Math.max(W,H) * 0.75);
  cg.addColorStop(0, 'rgba(0,0,0,0)');
  cg.addColorStop(1, 'rgba(60,90,200,0.15)');
  ctx.fillStyle = cg;
  ctx.fillRect(0, 0, W, H);
  ctx.restore();
}

/* =========================================================
   FIM DE JOGO
========================================================= */
const overlayEl = document.getElementById('overlay');
const panelEl = document.getElementById('panel');

function checkWin(){
  for (const k of ORE_ORDER){
    if (inv[k] < GOAL[k]) return;
  }
  endGame('win');
}

function endGame(state){
  if (gameState !== 'play') return;
  gameState = state;
  overlayEl.classList.remove('hidden');

  const listHTML = ORE_ORDER.map(k =>
    `<span><i style="background:${ORE_TYPES[k].color};box-shadow:0 0 10px ${ORE_TYPES[k].color}"></i> ${ORE_TYPES[k].name}: <b>${inv[k]}</b></span>`
  ).join('');

  if (state === 'win'){
    panelEl.className = 'panel win';
    panelEl.innerHTML = `
      <h2>🏆 Missão Cumprida!</h2>
      <p>Você encheu o carrinho com todos os minérios e sobreviveu à <b>Caverna dos Esqueletos</b>!</p>
      <div class="list">${listHTML}</div>
      <button class="go" id="btnRestart">JOGAR NOVAMENTE</button>
    `;
    beep(880, 0.15, 'triangle', 0.06);
    setTimeout(() => beep(1320, 0.18, 'triangle', 0.06), 100);
    setTimeout(() => beep(1760, 0.24, 'triangle', 0.06), 220);
  } else {
    panelEl.className = 'panel lose';
    panelEl.innerHTML = `
      <h2>💀 Os esqueletos venceram...</h2>
      <p>Seu carrinho foi destruído nas profundezas da caverna. Tente de novo!</p>
      <div class="list">${listHTML}</div>
      <button class="go" id="btnRestart">TENTAR DE NOVO</button>
    `;
    beep(220, 0.3, 'sawtooth', 0.07);
    setTimeout(() => beep(140, 0.45, 'sawtooth', 0.07), 180);
  }

  document.getElementById('btnRestart').addEventListener('click', () => {
    overlayEl.classList.add('hidden');
    init();
    gameState = 'play';
  });
}

function showStart(){
  overlayEl.classList.remove('hidden');
  panelEl.className = 'panel';
  panelEl.innerHTML = `
    <h1>🛒 Carrinho Minerador</h1>
    <p>Você é um carrinho de supermercado perdido numa <b>caverna cheia de esqueletos</b>.
    Minere minérios com sua picareta, use o escudo para se proteger e o paralisador para congelar os inimigos.</p>
    <div class="list">
      ${ORE_ORDER.map(k => `<span><i style="background:${ORE_TYPES[k].color};box-shadow:0 0 10px ${ORE_TYPES[k].color}"></i> ${ORE_TYPES[k].name} <b>${GOAL[k]}</b></span>`).join('')}
    </div>
    <div class="keys">
      <b>Joystick</b> (lado esquerdo) ou <b>A/D</b> / <b>←→</b> -- andar<br>
      <b>PULAR</b> / <b>Espaço</b> -- saltar<br>
      <b>MINERAR</b> (segure) / <b>E</b> -- picareta<br>
      <b>ESCUDO</b> (segure) / <b>Shift</b> -- bloquear dano<br>
      <b>PARALISADOR</b> / <b>Q</b> -- atordoar esqueletos
    </div>
    <button class="go" id="btnStart">COMEÇAR A MINERAR</button>
  `;
  document.getElementById('btnStart').addEventListener('click', () => {
    overlayEl.classList.add('hidden');
    init();
    gameState = 'play';
    beep(660, 0.12, 'triangle', 0.05);
    setTimeout(() => beep(990, 0.15, 'triangle', 0.05), 90);
    setTimeout(() => beep(1320, 0.18, 'triangle', 0.05), 180);
  });
}

/* =========================================================
   LOOP
========================================================= */
let lastT = performance.now();
function loop(now){
  let dt = (now - lastT) / 1000;
  lastT = now;
  if (dt > 0.05) dt = 0.05;
  update(dt);
  render();
  requestAnimationFrame(loop);
}

init();
buildHUD();
showStart();
requestAnimationFrame(loop);

})();
</script>
