========================================================= */
function oreTypeFor(x){
  const t = x / WORLD.w;
  const r = Math.random();
  if (t < 0.20) return r < 0.80 ? 'copper' : 'iron';
  if (t < 0.45) return r < 0.42 ? 'iron' : (r < 0.85 ? 'copper' : 'gold');
  if (t < 0.74) return r < 0.40 ? 'gold' : (r < 0.76 ? 'iron' : 'titanium');
  return r < 0.42 ? 'titanium' : (r < 0.78 ? 'gold' : 'iron');
}

function makeSkeleton(x, y, minX, maxX, big){
  const s = big ? 1.22 : 1;
  // Variação de tipo: guerreiro, arqueiro, mago, guardião
  const r = Math.random();
  let type = 'warrior';
  if (r > 0.85) type = 'guardian';
  else if (r > 0.65) type = 'mage';
  else if (r > 0.4) type = 'archer';

  // Paleta de roupas rasgadas
  const clothHues = [200, 270, 340, 20, 160, 300];
  const clothHue = clothHues[Math.floor(Math.random() * clothHues.length)];

  // Cor dos olhos
  let eyeColor;
  if (type === 'mage') eyeColor = '#b48cff';
  else if (type === 'guardian') eyeColor = '#ff9a3c';
  else if (type === 'archer') eyeColor = '#7fe9ff';
  else eyeColor = '#ff6a3c';

  // Runas/brilho nas costelas
  const runeHue = (clothHue + 60) % 360;

  return {
    x, y, w:34*s, h:58*s,
    vx:0, vy:0, onGround:false,
    minX, maxX, scale:s,
    hp: big ? 4 : (type === 'guardian' ? 5 : 3),
    maxHp: big ? 4 : (type === 'guardian' ? 5 : 3),
    stun:0, dir: Math.random() < 0.5 ? -1 : 1,
    hitFlash:0, anim: Math.random() * 10, dead:false,
    type, clothHue, runeHue, eyeColor,
    runePhase: Math.random() * 6,
    breathPhase: Math.random() * 6,
    blinkTimer: rand(1, 4),
    blink: 0,
    auraPulse: Math.random() * 6,
    // Fragmentos rasgados da túnica
    tatterSeed: Math.random() * 100,
  };
}

