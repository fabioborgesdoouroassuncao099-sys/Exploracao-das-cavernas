<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Carrinho Minerador -- Esqueletos Renascidos</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{
    width:100%;height:100%;overflow:hidden;background:#02040a;
    font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
    user-select:none;-webkit-user-select:none;touch-action:none;color:#e8f0ff;
  }
  canvas{display:block;position:fixed;inset:0;z-index:0}

  #hud{
    position:fixed;top:14px;left:14px;z-index:5;
    display:flex;flex-direction:column;gap:10px;pointer-events:none;
  }
  #hearts{display:flex;gap:6px;font-size:26px;line-height:1;
    filter:drop-shadow(0 3px 6px #000) drop-shadow(0 0 10px rgba(255,60,90,.5))}
  .heart{transition:transform .18s cubic-bezier(.34,1.56,.64,1), opacity .18s, filter .2s}
  .heart.off{opacity:.18;transform:scale(.72);filter:none}

  #shieldWrap{
    width:186px;height:18px;border-radius:11px;
    background:linear-gradient(180deg,rgba(0,0,0,.78),rgba(10,20,35,.78));
    border:2px solid rgba(120,200,255,.32);
    overflow:hidden;position:relative;
    box-shadow:0 4px 16px rgba(0,0,0,.65), inset 0 0 14px rgba(0,80,140,.45);
    backdrop-filter:blur(6px);
  }
  #shieldWrap::after{
    content:'';position:absolute;inset:0;
    background:repeating-linear-gradient(115deg,transparent 0 10px,rgba(255,255,255,.08) 10px 12px);
    pointer-events:none;
  }
  #shieldBar{
    height:100%;width:100%;
    background:linear-gradient(90deg,#1e6fff,#4fc3ff 45%,#b3f0ff 75%,#ffffff);
    box-shadow:0 0 18px rgba(120,220,255,.95), inset 0 0 10px rgba(255,255,255,.6);
    transition:width .08s linear;
    border-radius:9px;position:relative;
  }
  #shieldBar::after{
    content:'';position:absolute;top:1px;left:2px;right:2px;height:40%;
    background:linear-gradient(180deg,rgba(255,255,255,.7),transparent);
    border-radius:8px;pointer-events:none;
  }

  #inv{
    position:fixed;top:14px;right:14px;z-index:5;
    display:flex;flex-direction:column;gap:8px;pointer-events:none;
  }
  .slot{
    display:flex;align-items:center;gap:10px;
    background:linear-gradient(145deg,rgba(22,30,46,.85),rgba(9,13,22,.88));
    border:2px solid rgba(255,255,255,.1);
    border-radius:12px;padding:6px 12px;min-width:142px;
    font-size:13px;color:#dfe7f2;font-weight:700;
    box-shadow:0 6px 20px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.06);
    backdrop-filter:blur(8px);
    transition:border-color .25s, box-shadow .3s, transform .2s;
    position:relative;overflow:hidden;
  }
  .slot::before{
    content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
    background:var(--glow,#666);box-shadow:0 0 14px var(--glow,#666);
  }
  .slot.done{
    border-color:rgba(94,224,138,.6);
    box-shadow:0 6px 26px rgba(94,224,138,.4), inset 0 0 22px rgba(94,224,138,.14);
    transform:translateX(-3px);
  }
  .gem{
    width:16px;height:16px;border-radius:3px;transform:rotate(45deg);flex:none;
    box-shadow:0 0 14px currentColor, inset 0 0 7px rgba(255,255,255,.6);
    position:relative;
  }
  .gem::after{
    content:'';position:absolute;inset:2px;border-radius:1px;
    background:linear-gradient(135deg,rgba(255,255,255,.9),transparent 60%);
  }
  .slot .num{margin-left:auto;font-variant-numeric:tabular-nums;letter-spacing:.5px}
  .slot .goal{opacity:.45;font-size:11px;font-weight:600}

  #joy{
    position:fixed;width:160px;height:160px;border-radius:50%;
    border:2px solid rgba(140,200,255,.25);
    background:radial-gradient(circle at 50% 50%,rgba(120,180,255,.12),rgba(0,20,50,.05) 70%);
    display:none;z-index:9;pointer-events:none;
    box-shadow:0 0 44px rgba(60,140,255,.28), inset 0 0 34px rgba(60,140,255,.14);
    backdrop-filter:blur(3px);
  }
  #joy::before{
    content:'';position:absolute;inset:14px;border-radius:50%;
    border:1px dashed rgba(140,200,255,.2);
  }
  #knob{
    position:absolute;left:50%;top:50%;width:70px;height:70px;margin:-35px 0 0 -35px;
    border-radius:50%;
    background:radial-gradient(circle at 34% 28%,#b8cbe6 0%,#5a7392 35%,#2d3f5a 70%,#141d2d 100%);
    border:2px solid rgba(255,255,255,.45);
    box-shadow:0 8px 22px rgba(0,0,0,.75), inset 0 -4px 12px rgba(0,0,0,.55), inset 0 4px 12px rgba(255,255,255,.25);
  }
  #knob::after{
    content:'';position:absolute;left:20%;top:16%;width:34%;height:34%;border-radius:50%;
    background:radial-gradient(circle,rgba(255,255,255,.7),transparent 70%);
    filter:blur(2px);
  }

  #controls{
    position:fixed;right:16px;bottom:16px;z-index:10;
    display:grid;grid-template-columns:auto auto;gap:12px;align-items:end;
  }
  .btn{
    width:clamp(76px,16.5vmin,106px);height:clamp(76px,16.5vmin,106px);
    border-radius:50%;position:relative;
    border:2px solid rgba(255,255,255,.24);
    background:
      radial-gradient(circle at 34% 26%,rgba(255,255,255,.3),rgba(255,255,255,.06) 45%,transparent 60%),
      linear-gradient(160deg,rgba(46,62,90,.92),rgba(10,15,26,.94));
    color:#eaf1ff;font-family:inherit;font-weight:900;
    font-size:clamp(9px,1.75vmin,12px);letter-spacing:.7px;
    display:flex;align-items:center;justify-content:center;text-align:center;
    cursor:pointer;transition:transform .08s, box-shadow .16s, opacity .2s, filter .2s;
    box-shadow:
      0 8px 24px rgba(0,0,0,.7),
      inset 0 2px 12px rgba(255,255,255,.1),
      inset 0 -4px 14px rgba(0,0,0,.45);
    padding:6px;line-height:1.15;text-shadow:0 1px 3px rgba(0,0,0,.85);
    overflow:hidden;
  }
  .btn::before{
    content:'';position:absolute;inset:-30%;border-radius:50%;
    background:conic-gradient(from 0deg,transparent,var(--c,rgba(140,200,255,.55)),transparent 40%);
    opacity:0;transition:opacity .3s;
    animation:spin 3.5s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg)}}
  .btn:hover::before{opacity:.3}
  .btn:active,.btn.active{transform:scale(.9);box-shadow:0 0 34px var(--c,rgba(140,200,255,.85)), inset 0 0 22px rgba(255,255,255,.3)}
  .btn:active::before,.btn.active::before{opacity:.9}
  .btn.cd{opacity:.32;filter:grayscale(.8) brightness(.7)}
  #btnMine  {--c:rgba(255,190,90,.95);  border-color:rgba(255,190,90,.6);  color:#ffdcae}
  #btnShield{--c:rgba(110,190,255,.95); border-color:rgba(110,190,255,.6); color:#b9e2ff}
  #btnPara  {--c:rgba(180,120,255,.95); border-color:rgba(180,120,255,.6); color:#e0c7ff}
  #btnJump  {--c:rgba(140,255,180,.95); border-color:rgba(140,255,180,.55);color:#c8ffdd}

  #overlay{
    position:fixed;inset:0;z-index:30;display:flex;align-items:center;justify-content:center;
    background:radial-gradient(circle at 50% 40%,rgba(15,25,45,.85),rgba(1,3,7,.97));
    backdrop-filter:blur(6px);text-align:center;padding:24px;
    transition:opacity .35s;
  }
  #overlay.hidden{display:none}
  .panel{
    max-width:580px;color:#e6eefb;
    background:
      radial-gradient(circle at 30% -20%,rgba(90,140,220,.18),transparent 60%),
      linear-gradient(180deg,rgba(28,38,58,.95),rgba(10,15,26,.95));
    border:2px solid rgba(140,190,255,.2);
    border-radius:22px;
    padding:32px 30px;
    box-shadow:
      0 30px 80px rgba(0,0,0,.85),
      inset 0 1px 0 rgba(255,255,255,.1),
      0 0 60px rgba(60,120,220,.25);
    animation:panelIn .5s cubic-bezier(.34,1.4,.64,1);
  }
  @keyframes panelIn{from{opacity:0;transform:translateY(20px) scale(.94)}to{opacity:1;transform:none}}
  .panel h1{font-size:clamp(22px,5.4vmin,34px);margin-bottom:12px;
    background:linear-gradient(90deg,#ffd24a,#ff9a4a 35%,#8ef0ff 70%,#b48cff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    letter-spacing:.6px;filter:drop-shadow(0 0 26px rgba(255,180,90,.4));}
  .panel h2{font-size:clamp(19px,4.8vmin,28px);margin-bottom:12px;letter-spacing:.5px}
  .panel.win h2{color:#7dffb0;text-shadow:0 0 28px rgba(90,255,160,.6)}
  .panel.lose h2{color:#ff8181;text-shadow:0 0 28px rgba(255,80,80,.6)}
  .panel p{font-size:14.5px;line-height:1.7;opacity:.88;margin-bottom:16px}
  .panel p b{color:#8ef0ff}
  .panel .keys{
    font-size:13px;opacity:.8;line-height:1.9;margin-bottom:20px;
    background:rgba(0,0,0,.3);border-radius:12px;padding:14px 18px;
    border:1px solid rgba(255,255,255,.08);text-align:left;
  }
  .panel .keys b{color:#8ef0ff;font-weight:800}
  .go{
    display:inline-block;margin-top:8px;padding:16px 40px;border-radius:16px;border:none;
    background:linear-gradient(135deg,#ffd166,#ff8a3c 60%,#ff5a3c);
    color:#1a0d00;font-weight:900;
    font-size:17px;font-family:inherit;letter-spacing:.8px;cursor:pointer;
    box-shadow:
      0 12px 34px rgba(255,140,60,.55),
      inset 0 2px 0 rgba(255,255,255,.45),
      inset 0 -3px 0 rgba(140,50,0,.45);
    transition:transform .1s, box-shadow .2s;
    text-shadow:0 1px 0 rgba(255,255,255,.4);
  }
  .go:hover{box-shadow:0 14px 42px rgba(255,140,60,.7), inset 0 2px 0 rgba(255,255,255,.55), inset 0 -3px 0 rgba(140,50,0,.45)}
  .go:active{transform:scale(.95)}
  .list{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:18px;font-size:13px}
  .list span{display:flex;align-items:center;gap:7px;opacity:.92;font-weight:700}
  .list i{display:inline-block;width:12px;height:12px;transform:rotate(45deg);border-radius:3px}
</style>
</head>
<body>
<canvas id="game"></canvas>

<div id="hud">
  <div id="hearts"></div>
  <div id="shieldWrap"><div id="shieldBar"></div></div>
</div>

<div id="inv"></div>

<div id="joy"><div id="knob"></div></div>

<div id="controls">
  <button class="btn" id="btnShield">ESCUDO</button>
  <button class="btn" id="btnJump">PULAR</button>
  <button class="btn" id="btnPara">PARALISAR</button>
  <button class="btn" id="btnMine">MINERAR</button>
</div>

<div id="overlay"><div class="panel" id="panel"></div></div>

<script>
(() => {
"use strict";

/* =========================================================
   CONFIG
========================================================= */
const GRAV         = 2000;
const MOVE_SPEED   = 310;
const JUMP_V       = -895;
const MINE_DPS     = 90;
const ORE_REACH    = 100;
const SHIELD_DRAIN = 30;
const SHIELD_REGEN = 18;
const PARA_CD      = 3.2;
const STUN_TIME    = 5.0;
const WORLD        = { w: 4600, h: 1100 };
const MAX_PARTICLES = 460;

const ORE_TYPES = {
  copper:   { name:'Cobre',   color:'#ff8a4a', light:'#ffd3a8', dark:'#7a2f10', hp: 55,  glow:0.85, hue:24  },
  iron:     { name:'Ferro',   color:'#d3dde8', light:'#ffffff', dark:'#5a6473', hp: 95,  glow:0.7,  hue:210 },
  gold:     { name:'Ouro',    color:'#ffd24a', light:'#fff6b8', dark:'#9c6f06', hp: 150, glow:1.0,  hue:45  },
  titanium: { name:'Titânio', color:'#9ef2ff', light:'#eaffff', dark:'#25879c', hp: 240, glow:1.15, hue:188 },
};
const ORE_ORDER = ['copper','iron','gold','titanium'];
const GOAL = { copper:10, iron:10, gold:8, titanium:5 };

/* =========================================================
   CANVAS
========================================================= */
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d', { alpha:false });
let W = 0, H = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);

function resize(){
  W = window.innerWidth; H = window.innerHeight;
  canvas.width  = Math.floor(W * DPR);
  canvas.height = Math.floor(H * DPR);
  canvas.style.width  = W + 'px';
  canvas.style.height = H + 'px';
}
window.addEventListener('resize', resize);
resize();

/* =========================================================
   ESTADO
========================================================= */
let gameState = 'start';
let platforms = [];
let ores = [];
let skeletons = [];
let bolts = [];
let particles = [];
let floaters = [];
let ambient = [];
let drips = [];
let decor = [];
let cam = { x:0, y:0 };
let shake = { t:0, m:0 };
let time = 0;
let flash = { t:0, c:'#fff', m:0 };

const inv = { copper:0, iron:0, gold:0, titanium:0 };

const player = {
  x:100, y:860, w:56, h:46,
  vx:0, vy:0, onGround:false, facing:1,
  hp:5, maxHp:5,
  invuln:0, coyote:0, jumpBuffer:0,
  shieldEnergy:100, shielding:false, shieldGlow:0,
  paraCd:0, swing:0, mining:false, hitCd:0,
  squash:1, dustTimer:0,
};

/* =========================================================
   INPUT
========================================================= */
const input = { joyX:0, joyY:0, mine:false, shield:false };
const keys = Object.create(null);
let jumpQueued = false, paraQueued = false;

window.addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  keys[k] = true;
  if (k === ' ' || k === 'w' || k === 'arrowup'){ jumpQueued = true; e.preventDefault(); }
  if (k === 'q') paraQueued = true;
  if (k === 'e') input.mine = true;
  if (k === 'shift') input.shield = true;
  if (['arrowleft','arrowright','arrowdown'].includes(k)) e.preventDefault();
});
window.addEventListener('keyup', e => {
  const k = e.key.toLowerCase();
  keys[k] = false;
  if (k === 'e') input.mine = false;
  if (k === 'shift') input.shield = false;
});

const joyEl = document.getElementById('joy');
const knobEl = document.getElementById('knob');
let joyId = null, joyBaseX = 0, joyBaseY = 0;
const JOY_R = 62;

function updateJoy(cx, cy){
  let dx = cx - joyBaseX, dy = cy - joyBaseY;
  const d = Math.hypot(dx, dy);
  if (d > JOY_R){ dx = dx / d * JOY_R; dy = dy / d * JOY_R; }
  knobEl.style.transform = `translate(${dx}px, ${dy}px)`;
  input.joyX = dx / JOY_R;
  input.joyY = dy / JOY_R;
}

window.addEventListener('pointerdown', e => {
  if (e.target.closest('.btn') || e.target.closest('#overlay')) return;
  if (joyId !== null) return;
  if (e.clientX > window.innerWidth * 0.55) return;
  joyId = e.pointerId;
  joyBaseX = e.clientX; joyBaseY = e.clientY;
  joyEl.style.display = 'block';
  joyEl.style.left = (e.clientX - 80) + 'px';
  joyEl.style.top  = (e.clientY - 80) + 'px';
  knobEl.style.transform = 'translate(0,0)';
  input.joyX = 0; input.joyY = 0;
}, { passive:true });

window.addEventListener('pointermove', e => {
  if (e.pointerId !== joyId) return;
  updateJoy(e.clientX, e.clientY);
}, { passive:true });

function endJoy(e){
  if (e.pointerId !== joyId) return;
  joyId = null;
  joyEl.style.display = 'none';
  input.joyX = 0; input.joyY = 0;
}
window.addEventListener('pointerup', endJoy);
window.addEventListener('pointercancel', endJoy);

function bindHoldButton(id, onDown, onUp){
  const el = document.getElementById(id);
  el.addEventListener('pointerdown', e => {
    e.preventDefault(); e.stopPropagation();
    try { el.setPointerCapture(e.pointerId); } catch(_){}
    el.classList.add('active');
    if (onDown) onDown();
  });
  const release = e => {
    e.preventDefault(); e.stopPropagation();
    el.classList.remove('active');
    if (onUp) onUp();
  };
  el.addEventListener('pointerup', release);
  el.addEventListener('pointercancel', release);
  el.addEventListener('contextmenu', e => e.preventDefault());
}
bindHoldButton('btnMine',  () => input.mine = true,   () => input.mine = false);
bindHoldButton('btnShield',() => input.shield = true, () => input.shield = false);
bindHoldButton('btnJump',  () => jumpQueued = true);
bindHoldButton('btnPara',  () => paraQueued = true);

/* =========================================================
   HELPERS
========================================================= */
const aabb = (a,b) => a.x < b.x+b.w && a.x+a.w > b.x && a.y < b.y+b.h && a.y+a.h > b.y;
const clamp = (v,a,b) => v < a ? a : (v > b ? b : v);
const rand = (a,b) => a + Math.random() * (b - a);

function roundRect(c,x,y,w,h,r){
  r = Math.min(r, w/2, h/2);
  c.beginPath();
  c.moveTo(x+r,y);
  c.arcTo(x+w,y,x+w,y+h,r);
  c.arcTo(x+w,y+h,x,y+h,r);
  c.arcTo(x,y+h,x,y,r);
  c.arcTo(x,y,x+w,y,r);
  c.closePath();
}
function addShake(mag){ shake.m = Math.max(shake.m, mag); shake.t = 1; }
function addFlash(color, mag){ flash.c = color; flash.m = mag; flash.t = 1; }

/* =========================================================
   PARTÍCULAS
========================================================= */
const PT = { DUST:'dust', SPARK:'spark', EMBER:'ember', MAGIC:'magic', CHUNK:'chunk', RING:'ring', BONE:'bone', SOUL:'soul' };

function spawnParticles(x, y, color, count, speed, life, type, opts){
  type = type || PT.DUST;
  opts = opts || {};
  const room = MAX_PARTICLES - particles.length;
  if (room <= 0) return;
  count = Math.min(count, room);
  for (let i = 0; i < count; i++){
    const a = Math.random() * Math.PI * 2;
    const s = speed * (0.2 + Math.random() * 0.9);
    particles.push({
      x, y,
      vx: Math.cos(a) * s + (opts.vx || 0),
      vy: Math.sin(a) * s - (opts.up || 40) + (opts.vy || 0),
      life: life * (0.5 + Math.random() * 0.7),
      maxLife: life,
      color,
      size: (opts.size || 2) + Math.random() * (opts.sizeVar || 2.5),
      type,
      rot: Math.random() * Math.PI * 2,
      spin: rand(-6, 6),
      grav: opts.grav !== undefined ? opts.grav : 900,
      drag: opts.drag !== undefined ? opts.drag : 0,
    });
  }
}

function updateParticles(dt){
  for (let i = particles.length - 1; i >= 0; i--){
    const p = particles[i];
    p.vy += p.grav * dt;
    if (p.drag){ p.vx *= (1 - p.drag * dt); p.vy *= (1 - p.drag * dt); }
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.rot += p.spin * dt;
    p.life -= dt;
    if (p.life <= 0) particles.splice(i, 1);
  }
}

function drawParticles(){
  ctx.save();
  for (const p of particles){
    const a = Math.max(0, p.life / p.maxLife);
    const alpha = a * a;
    switch (p.type){
      case PT.SPARK: {
        ctx.globalAlpha = alpha;
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * a, 0, 7);
        ctx.fill();
        break;
      }
      case PT.EMBER: {
        ctx.globalAlpha = alpha * 0.9;
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * 2.8);
        g.addColorStop(0, p.color);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * 2.8, 0, 7);
        ctx.fill();
        break;
      }
      case PT.MAGIC: {
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = p.color;
        ctx.lineWidth = 1.6;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 10;
        const s = p.size * a * 1.6;
        ctx.beginPath();
        ctx.moveTo(p.x - s, p.y); ctx.lineTo(p.x + s, p.y);
        ctx.moveTo(p.x, p.y - s); ctx.lineTo(p.x, p.y + s);
        ctx.stroke();
        break;
      }
      case PT.CHUNK: {
        ctx.globalAlpha = alpha;
        ctx.fillStyle = p.color;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 6;
        ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);
        ctx.restore();
        break;
      }
      case PT.RING: {
        ctx.globalAlpha = alpha * 0.8;
        ctx.strokeStyle = p.color;
        ctx.lineWidth = 3 * a;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 16;
        ctx.beginPath();
        ctx.arc(p.x, p.y, (1 - a) * p.size * 8 + 4, 0, 7);
        ctx.stroke();
        break;
      }
      case PT.BONE: {
        // Pequenos ossos girando
        ctx.globalAlpha = alpha;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;
        ctx.shadowColor = 'rgba(220,215,190,0.6)';
        ctx.shadowBlur = 5;
        const s = p.size;
        ctx.fillRect(-s, -s*0.35, s*2, s*0.7);
        ctx.beginPath();
        ctx.arc(-s, 0, s*0.55, 0, 7);
        ctx.arc(s, 0, s*0.55, 0, 7);
        ctx.fill();
        ctx.restore();
        break;
      }
      case PT.SOUL: {
        // Alma/energia subindo
        ctx.globalAlpha = alpha * 0.85;
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * 3);
        g.addColorStop(0, '#ffffff');
        g.addColorStop(0.3, p.color);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * 3, 0, 7);
        ctx.fill();
        break;
      }
      default: {
        ctx.globalAlpha = alpha * 0.7;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * (0.5 + a * 0.5), 0, 7);
        ctx.fill();
      }
    }
  }
  ctx.restore();
  ctx.globalAlpha = 1;
  ctx.shadowBlur = 0;
}

function spawnFloater(x, y, text, color){
  floaters.push({ x, y, vy:-70, life:1.1, maxLife:1.1, text, color });
}
function updateFloaters(dt){
  for (let i = floaters.length - 1; i >= 0; i--){
    const f = floaters[i];
    f.y += f.vy * dt;
    f.vy *= (1 - 2 * dt);
    f.life -= dt;
    if (f.life <= 0) floaters.splice(i, 1);
  }
}
function drawFloaters(){
  ctx.save();
  ctx.textAlign = 'center';
  ctx.font = '900 15px system-ui, sans-serif';
  for (const f of floaters){
    const a = Math.min(1, f.life / f.maxLife * 1.6);
    ctx.globalAlpha = a;
    ctx.fillStyle = f.color;
    ctx.shadowColor = f.color;
    ctx.shadowBlur = 16;
    ctx.fillText(f.text, f.x, f.y);
    ctx.shadowBlur = 0;
    ctx.fillStyle = 'rgba(255,255,255,.95)';
    ctx.fillText(f.text, f.x, f.y - 1);
  }
  ctx.restore();
  ctx.globalAlpha = 1;
}

/* =========================================================
   ÁUDIO
========================================================= */
let actx = null;
function beep(freq, dur, type, vol){
  try {
    if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
    if (actx.state === 'suspended') actx.resume();
    const o = actx.createOscillator(), g = actx.createGain();
    o.type = type || 'square';
    o.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.05, actx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + dur);
    o.connect(g); g.connect(actx.destination);
    o.start(); o.stop(actx.currentTime + dur);
  } catch(_){}
}
function noiseHit(vol){
  try {
    if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
    const dur = 0.12;
    const buf = actx.createBuffer(1, actx.sampleRate * dur, actx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++){
      data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
    }
    const src = actx.createBufferSource();
    src.buffer = buf;
    const g = actx.createGain();
    g.gain.value = vol || 0.05;
    const filt = actx.createBiquadFilter();
    filt.type = 'bandpass';
    filt.frequency.value = 800 + Math.random() * 900;
    filt.Q.value = 1.2;
    src.connect(filt); filt.connect(g); g.connect(actx.destination);
    src.start();
  } catch(_){}
}

/* =========================================================
