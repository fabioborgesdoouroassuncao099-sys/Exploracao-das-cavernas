   RENDER -- CARRINHO
========================================================= */
function drawPlayer(){
  const p = player;
  const blink = p.invuln > 0 && Math.floor(p.invuln * 20) % 2 === 0;

  ctx.save();
  if (blink) ctx.globalAlpha = 0.5;

  ctx.translate(p.x + p.w / 2, p.y + p.h / 2);
  ctx.scale(p.facing, 1);
  const sy = p.squash;
  const sx = 1 / sy;
  ctx.scale(sx, sy);
  ctx.translate(-p.w / 2, -p.h / 2);

  const bounce = (p.onGround && Math.abs(p.vx) > 20) ? Math.sin(time * 22) * 1.3 : 0;
  ctx.translate(0, bounce);

  const wheelY = 36;
  const wheelR = 8.5;

  ctx.globalAlpha *= 0.42;
  ctx.fillStyle = '#000';
  ctx.beginPath();
  ctx.ellipse(p.w/2, p.h + 6, 26, 6, 0, 0, 7);
  ctx.fill();
  ctx.globalAlpha /= 0.42;

  for (const wx of [15, 41]){
    const tireGrad = ctx.createRadialGradient(wx - 2, wheelY - 2, 1, wx, wheelY, wheelR);
    tireGrad.addColorStop(0, '#2a2f3a');
    tireGrad.addColorStop(1, '#05070b');
    ctx.fillStyle = tireGrad;
    ctx.beginPath(); ctx.arc(wx, wheelY, wheelR, 0, 7); ctx.fill();

    ctx.strokeStyle = 'rgba(60,70,85,0.6)';
    ctx.lineWidth = 0.8;
    for (let k = 0; k < 8; k++){
      const a = k * Math.PI / 4 + time * (p.vx * 0.02);
      ctx.beginPath();
      ctx.moveTo(wx + Math.cos(a) * (wheelR - 1.2), wheelY + Math.sin(a) * (wheelR - 1.2));
      ctx.lineTo(wx + Math.cos(a) * (wheelR - 2.8), wheelY + Math.sin(a) * (wheelR - 2.8));
      ctx.stroke();
    }

    const rimGrad = ctx.createRadialGradient(wx - 1, wheelY - 1, 0.5, wx, wheelY, wheelR - 1.5);
    rimGrad.addColorStop(0, '#e8eef7');
    rimGrad.addColorStop(0.5, '#a5b0c2');
    rimGrad.addColorStop(1, '#5a6478');
    ctx.fillStyle = rimGrad;
    ctx.beginPath(); ctx.arc(wx, wheelY, wheelR - 1.8, 0, 7); ctx.fill();

    ctx.fillStyle = '#2d3441';
    ctx.beginPath(); ctx.arc(wx, wheelY, wheelR - 3.4, 0, 7); ctx.fill();
    ctx.fillStyle = '#7c8899';
    ctx.beginPath(); ctx.arc(wx, wheelY, wheelR - 4.2, 0, 7); ctx.fill();

    const hubGrad = ctx.createRadialGradient(wx - 0.6, wheelY - 0.6, 0.3, wx, wheelY, 2.6);
    hubGrad.addColorStop(0, '#ffffff');
    hubGrad.addColorStop(0.5, '#c9d3e3');
    hubGrad.addColorStop(1, '#5e6878');
    ctx.fillStyle = hubGrad;
    ctx.beginPath(); ctx.arc(wx, wheelY, 2.4, 0, 7); ctx.fill();

    const rot = time * (p.vx * 0.025);
    ctx.strokeStyle = 'rgba(200,215,235,0.7)';
    ctx.lineWidth = 1.6;
    ctx.lineCap = 'round';
    for (let k = 0; k < 5; k++){
      const a = rot + k * Math.PI * 2 / 5;
      ctx.beginPath();
      ctx.moveTo(wx, wheelY);
      ctx.lineTo(wx + Math.cos(a) * (wheelR - 5), wheelY + Math.sin(a) * (wheelR - 5));
      ctx.stroke();
    }

    ctx.strokeStyle = 'rgba(255,255,255,0.75)';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.arc(wx, wheelY, wheelR - 2.2, -Math.PI * 0.85, -Math.PI * 0.15);
    ctx.stroke();
  }

  ctx.strokeStyle = '#5a6478';
  ctx.lineWidth = 3;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(15, wheelY);
  ctx.lineTo(41, wheelY);
  ctx.stroke();
  ctx.strokeStyle = '#b8c3d5';
  ctx.lineWidth = 1.4;
  ctx.beginPath();
  ctx.moveTo(15, wheelY - 0.8);
  ctx.lineTo(41, wheelY - 0.8);
  ctx.stroke();

  ctx.strokeStyle = '#3a4152';
  ctx.lineWidth = 7;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(10, 10);
  ctx.lineTo(1, -5);
  ctx.stroke();
  const handleGrad = ctx.createLinearGradient(10, 10, 0, -5);
  handleGrad.addColorStop(0, '#a8b3c4');
  handleGrad.addColorStop(0.5, '#7a8699');
  handleGrad.addColorStop(1, '#4a5466');
  ctx.strokeStyle = handleGrad;
  ctx.lineWidth = 5;
  ctx.beginPath();
  ctx.moveTo(10, 10);
  ctx.lineTo(1, -5);
  ctx.stroke();
  ctx.strokeStyle = 'rgba(255,255,255,0.75)';
  ctx.lineWidth = 1.4;
  ctx.beginPath();
  ctx.moveTo(9, 8);
  ctx.lineTo(3, -2);
  ctx.stroke();
  const gripGrad = ctx.createRadialGradient(0, -5, 0.5, 0, -5, 4.5);
  gripGrad.addColorStop(0, '#d9e0ec');
  gripGrad.addColorStop(1, '#546075');
  ctx.fillStyle = gripGrad;
  ctx.beginPath(); ctx.arc(0, -5, 4, 0, 7); ctx.fill();
  ctx.strokeStyle = '#2f3648';
  ctx.lineWidth = 1.4;
  ctx.beginPath(); ctx.arc(0, -5, 4, 0, 7); ctx.stroke();

  const basketPath = () => {
    ctx.beginPath();
    ctx.moveTo(7, 5);
    ctx.lineTo(49, 5);
    ctx.lineTo(43, 31);
    ctx.lineTo(13, 31);
    ctx.closePath();
  };

  ctx.fillStyle = '#2a3142';
  ctx.fillRect(6, 3, 44, 4);
  ctx.fillStyle = '#5a6478';
  ctx.fillRect(6, 3, 44, 1.5);

  const basketGrad = ctx.createLinearGradient(0, 5, 0, 31);
  basketGrad.addColorStop(0, '#e0e7f2');
  basketGrad.addColorStop(0.12, '#c8d2e0');
  basketGrad.addColorStop(0.4, '#96a3b8');
  basketGrad.addColorStop(0.7, '#69768c');
  basketGrad.addColorStop(1, '#414a5c');
  ctx.fillStyle = basketGrad;
  basketPath();
  ctx.fill();

  ctx.strokeStyle = '#1f2530';
  ctx.lineWidth = 2;
  basketPath();
  ctx.stroke();

  ctx.save();
  basketPath();
  ctx.clip();

  for (let i = 1; i <= 6; i++){
    const t = i / 7;
    const xt = 7 + (49 - 7) * t;
    const xb = 13 + (43 - 13) * t;
    ctx.strokeStyle = 'rgba(30,38,52,0.9)';
    ctx.lineWidth = 2.4;
    ctx.beginPath();
    ctx.moveTo(xt + 0.8, 5);
    ctx.lineTo(xb + 0.8, 31);
    ctx.stroke();
    ctx.strokeStyle = 'rgba(200,210,225,0.6)';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(xt, 5);
    ctx.lineTo(xb, 31);
    ctx.stroke();
    ctx.strokeStyle = 'rgba(255,255,255,0.5)';
    ctx.lineWidth = 0.6;
    ctx.beginPath();
    ctx.moveTo(xt - 0.3, 5);
    ctx.lineTo(xb - 0.3, 31);
    ctx.stroke();
  }

  for (let j = 1; j <= 3; j++){
    const y = 5 + (31 - 5) * (j / 4);
    const xl = 7 + (13 - 7) * (j / 4);
    const xr = 49 + (43 - 49) * (j / 4);
    ctx.strokeStyle = 'rgba(30,38,52,0.9)';
    ctx.lineWidth = 2.2;
    ctx.beginPath();
    ctx.moveTo(xl, y + 0.8);
    ctx.lineTo(xr, y + 0.8);
    ctx.stroke();
    ctx.strokeStyle = 'rgba(200,210,225,0.55)';
    ctx.lineWidth = 1.1;
    ctx.beginPath();
    ctx.moveTo(xl, y);
    ctx.lineTo(xr, y);
    ctx.stroke();
  }

  ctx.restore();

  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  ctx.beginPath();
  ctx.moveTo(10, 7);
  ctx.lineTo(22, 7);
  ctx.lineTo(18, 28);
  ctx.lineTo(14, 28);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = 'rgba(255,255,255,0.7)';
  ctx.beginPath();
  ctx.moveTo(11, 8);
  ctx.lineTo(14, 8);
  ctx.lineTo(13.4, 22);
  ctx.lineTo(11.6, 22);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = 'rgba(255,255,255,0.15)';
  ctx.beginPath();
  ctx.moveTo(40, 8);
  ctx.lineTo(45, 8);
  ctx.lineTo(42, 28);
  ctx.lineTo(39, 28);
  ctx.closePath();
  ctx.fill();

  const rimGrad = ctx.createLinearGradient(0, 5, 0, 9);
  rimGrad.addColorStop(0, 'rgba(255,255,255,0.85)');
  rimGrad.addColorStop(1, 'rgba(255,255,255,0)');
  ctx.fillStyle = rimGrad;
  ctx.fillRect(8, 5, 40, 4);

  ctx.save();
  ctx.fillStyle = 'rgba(180,60,60,0.75)';
  roundRect(ctx, 20, 16, 14, 7, 2);
  ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,0.9)';
  ctx.font = '700 4.5px system-ui, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('MERCADO', 27, 19.5);
  ctx.restore();

  let px = 17;
  let py = 24;
  for (const k of ORE_ORDER){
    const n = Math.min(inv[k], 5);
    for (let i = 0; i < n; i++){
      if (px > 44) break;
      const col = ORE_TYPES[k].color;
      const lcol = ORE_TYPES[k].light;
      ctx.shadowColor = col;
      ctx.shadowBlur = 9;
      ctx.fillStyle = col;
      ctx.beginPath();
      const bx = px + (i % 3) * 3;
      const by = py - (i % 3) * 3;
      ctx.moveTo(bx, by - 3.6);
      ctx.lineTo(bx + 2.6, by);
      ctx.lineTo(bx, by + 3.6);
      ctx.lineTo(bx - 2.6, by);
      ctx.closePath();
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.fillStyle = lcol;
      ctx.beginPath();
      ctx.moveTo(bx, by - 3.6);
      ctx.lineTo(bx + 2.6, by);
      ctx.lineTo(bx, by);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.95)';
      ctx.beginPath();
      ctx.arc(bx - 0.8, by - 1.4, 0.7, 0, 7);
      ctx.fill();
      px += 7;
      if (px > 44){ px = 17; py -= 4; }
    }
  }

  ctx.save();
  ctx.globalAlpha = 0.35;
  ctx.fillStyle = '#0a0d14';
  ctx.beginPath();
  ctx.arc(46, wheelY + 2, 4.5, 0, 7);
