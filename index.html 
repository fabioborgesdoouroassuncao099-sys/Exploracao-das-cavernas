    ctx.strokeStyle = 'rgba(255,255,220,0.7)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(0, 0, 26, -1.15, 0.15);
    ctx.stroke();

    ctx.strokeStyle = '#3d2410';
    ctx.lineWidth = 6.5;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.lineTo(26, 0);
    ctx.stroke();

    const woodGrad = ctx.createLinearGradient(0, -3, 0, 3);
    woodGrad.addColorStop(0, '#c98a4a');
    woodGrad.addColorStop(0.5, '#8a5a28');
    woodGrad.addColorStop(1, '#5a3818');
    ctx.strokeStyle = woodGrad;
    ctx.lineWidth = 4.5;
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.lineTo(26, 0);
