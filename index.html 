/* =========================================================
   FÍSICA
========================================================= */
function moveAndCollide(e, dt, horizontal){
  if (horizontal){
    e.x += e.vx * dt;
    for (const p of platforms){
      if (aabb(e, p)){
        if (e.vx > 0) e.x = p.x - e.w;
        else if (e.vx < 0) e.x = p.x + p.w;
        e.vx = 0;
      }
    }
  }
  e.vy += GRAV * dt;
  if (e.vy > 1500) e.vy = 1500;
  e.y += e.vy * dt;
  e.onGround = false;
  for (const p of platforms){
    if (aabb(e, p)){
      if (e.vy > 0){ e.y = p.y - e.h; e.vy = 0; e.onGround = true; }
      else if (e.vy < 0){ e.y = p.y + p.h; e.vy = 0; }
    }
  }
}

/* =========================================================
   UPDATE JOGADOR
========================================================= */
function updatePlayer(dt){
  const p = player;

  let ax = input.joyX;
  if (keys['a'] || keys['arrowleft'])  ax -= 1;
  if (keys['d'] || keys['arrowright']) ax += 1;
  ax = clamp(ax, -1, 1);

  if (Math.abs(ax) > 0.18) p.facing = ax > 0 ? 1 : -1;

  const wantShield = input.shield || keys['shift'];
  if (wantShield && p.shieldEnergy > 1){
    p.shielding = true;
    p.shieldEnergy = Math.max(0, p.shieldEnergy - SHIELD_DRAIN * dt);
    p.shieldGlow = Math.min(1, p.shieldGlow + dt * 8);
  } else {
    p.shielding = false;
    p.shieldEnergy = Math.min(100, p.shieldEnergy + SHIELD_REGEN * dt);
    p.shieldGlow = Math.max(0, p.shieldGlow - dt * 6);
  }

  const speed = p.shielding ? MOVE_SPEED * 0.42 : MOVE_SPEED;
  p.vx = ax * speed;
  if (Math.abs(ax) < 0.1) p.vx = 0;

  p.squash += (1 - p.squash) * Math.min(1, dt * 10);

  if (jumpQueued){ p.jumpBuffer = 0.15; jumpQueued = false; }
  p.jumpBuffer -= dt;

  if (p.onGround) p.coyote = 0.11;
  else p.coyote = Math.max(0, p.coyote - dt);

  if (p.jumpBuffer > 0 && p.coyote > 0){
    p.vy = JUMP_V;
    p.jumpBuffer = 0; p.coyote = 0;
    p.squash = 0.78;
    spawnParticles(p.x + p.w/2, p.y + p.h, '#9fb2ce', 10, 140, 0.5, PT.DUST, { size:2, up:60, grav:500 });
    beep(430, 0.09, 'square', 0.035);
  }
  const holdingJump = keys[' '] || keys['w'] || keys['arrowup'] ||
                      document.getElementById('btnJump').classList.contains('active');
  if (!holdingJump && p.vy < -300) p.vy = -300;

  const wasAir = !p.onGround;
  moveAndCollide(p, dt, true);
  p.x = clamp(p.x, 0, WORLD.w - p.w);

  if (p.onGround && Math.abs(p.vx) > 60){
    p.dustTimer -= dt;
    if (p.dustTimer <= 0){
      p.dustTimer = 0.07;
      spawnParticles(p.x + p.w/2 - p.facing * 16, p.y + p.h - 2,
        'rgba(160,180,210,0.6)', 2, 40, 0.5, PT.DUST,
        { size:2, up:20, grav:120, vx:-p.vx * 0.15 });
    }
  }
  if (wasAir && p.onGround && p.vy > 200){
    spawnParticles(p.x + p.w/2, p.y + p.h, 'rgba(170,190,215,0.7)', 8, 120, 0.45, PT.DUST, { size:2.5, up:30 });
  }

  if (p.invuln > 0) p.invuln -= dt;
  if (p.hitCd > 0) p.hitCd -= dt;
  if (p.paraCd > 0) p.paraCd -= dt;

  if (paraQueued){
    paraQueued = false;
    if (p.paraCd <= 0 && gameState === 'play'){
      p.paraCd = PARA_CD;
      bolts.push({
        x: p.x + p.w/2 + p.facing * 28, y: p.y + p.h/2 - 4,
        vx: p.facing * 780, vy: 0, life: 1.3, r: 10,
        trail: [], hue: rand(260, 290),
      });
      beep(940, 0.12, 'sawtooth', 0.05);
      beep(1420, 0.1, 'sine', 0.03);
      spawnParticles(p.x + p.w/2 + p.facing * 32, p.y + p.h/2, '#c9a0ff', 16, 260, 0.45, PT.MAGIC);
      spawnParticles(p.x + p.w/2 + p.facing * 32, p.y + p.h/2, '#ffffff', 6, 180, 0.3, PT.SPARK, { size:2 });
    } else if (p.paraCd > 0){
      beep(180, 0.08, 'square', 0.03);
    }
  }
}

/* =========================================================
   MINERAÇÃO
========================================================= */
function updateMining(dt){
  const p = player;
  if (!input.mine || gameState !== 'play'){ p.mining = false; return; }
  p.mining = true;
  p.swing += dt * 15;

  const pcx = p.x + p.w/2;
  const pcy = p.y + p.h/2;

  if (p.hitCd <= 0){
    for (const s of skeletons){
      if (s.dead) continue;
      const sx = s.x + s.w/2;
      const dx = sx - pcx;
      if (Math.abs(dx) < 84 && Math.abs((s.y + s.h/2) - pcy) < 76 && Math.sign(dx) === p.facing){
        s.hp--;
        s.hitFlash = 0.2;
        p.hitCd = 0.36;
        s.x += p.facing * 16;
        addShake(4);
        spawnParticles(sx, s.y + s.h/2, '#f0eee2', 12, 230, 0.5, PT.BONE, { size:3 });
        spawnParticles(sx, s.y + s.h/2, '#ffd9a8', 5, 180, 0.35, PT.SPARK, { size:1.6 });
        noiseHit(0.05);
        spawnFloater(sx, s.y, '-1', '#ff9c7a');
        if (s.hp <= 0){
          s.dead = true;
          // Explosão de ossos
          spawnParticles(sx, s.y + s.h/2, '#f0eee2', 22, 280, 0.9, PT.BONE, { size:3.5 });
          spawnParticles(sx, s.y + s.h/2, '#d8d2b8', 10, 200, 0.7, PT.CHUNK, { size:3 });
          // Alma subindo
          spawnParticles(sx, s.y + s.h/2 - 10, s.eyeColor, 8, 60, 1.2, PT.SOUL, { size:3, grav:-60, up:50 });
          spawnParticles(sx, s.y + s.h/2, '#ff5566', 10, 200, 0.7, PT.EMBER, { size:2.5 });
          spawnParticles(sx, s.y + s.h/2, '#ffffff', 8, 160, 0.5, PT.SPARK, { size:2 });
          beep(120, 0.28, 'sawtooth', 0.06);
          addShake(7);
          addFlash('rgba(255,90,90,0.18)', 1);
        }
        break;
      }
    }
  }

  let best = null, bestD = 1e9;
  for (const o of ores){
    if (o.done) continue;
    const ox = o.x + o.w/2, oy = o.y + o.h/2;
    const d = Math.hypot(ox - pcx, oy - pcy);
    if (d < ORE_REACH && d < bestD){ bestD = d; best = o; }
  }
  if (!best) return;

  const t = ORE_TYPES[best.type];
  best.hp -= MINE_DPS * dt;
  best.shake = 0.1;

  if (Math.random() < dt * 55){
    spawnParticles(
      best.x + best.w/2 + rand(-16, 16),
      best.y + best.h/2 + rand(-16, 16),
      t.color, 2, 190, 0.4, PT.SPARK, { size:1.6 }
    );
  }
  if (Math.random() < dt * 22){
    spawnParticles(
      best.x + best.w/2 + rand(-14, 14),
      best.y + best.h/2 + rand(-14, 14),
      t.light, 1, 130, 0.5, PT.CHUNK, { size:2.5 }
    );
  }
  if (Math.random() < dt * 10){
    noiseHit(0.02);
  }

  if (best.hp <= 0){
    best.done = true;
    inv[best.type]++;
    addShake(5);
    spawnParticles(best.x + best.w/2, best.y + best.h/2, t.color, 26, 300, 0.9, PT.CHUNK, { size:3.2 });
    spawnParticles(best.x + best.w/2, best.y + best.h/2, t.light, 14, 220, 0.7, PT.SPARK, { size:2 });
    spawnParticles(best.x + best.w/2, best.y + best.h/2, t.color, 6, 80, 0.8, PT.RING, { size:1 });
    spawnFloater(best.x + best.w/2, best.y - 4, '+1 ' + t.name, t.color);
    beep(1046, 0.14, 'triangle', 0.06);
    setTimeout(() => beep(1568, 0.16, 'triangle', 0.05), 70);
    checkWin();
  }
}

/* =========================================================
   INIMIGOS
========================================================= */
function updateSkeletons(dt){
  for (let i = skeletons.length - 1; i >= 0; i--){
    const s = skeletons[i];
    if (s.dead){ skeletons.splice(i, 1); continue; }

    s.anim += dt;
    if (s.hitFlash > 0) s.hitFlash -= dt;

    // Piscar de olhos
    s.blinkTimer -= dt;
    if (s.blinkTimer <= 0){
      s.blink = 0.16;
      s.blinkTimer = rand(2, 6);
    }
    if (s.blink > 0) s.blink -= dt;

    if (s.stun > 0){
      s.stun -= dt;
      s.vx = 0;
      if (Math.random() < dt * 18){
        spawnParticles(s.x + s.w/2 + rand(-16,16), s.y + rand(0, s.h), '#c9a0ff', 1, 100, 0.4, PT.MAGIC);
      }
    } else {
      const dx = (player.x + player.w/2) - (s.x + s.w/2);
      const dy = (player.y + player.h/2) - (s.y + s.h/2);
      if (Math.abs(dx) < 340 && Math.abs(dy) < 115){
        s.dir = dx > 0 ? 1 : -1;
        s.vx = s.dir * 122;
      } else {
        s.vx = s.dir * 60;
      }
    }

    s.x += s.vx * dt;
    if (s.x < s.minX){ s.x = s.minX; s.dir = 1; }
    if (s.x > s.maxX){ s.x = s.maxX; s.dir = -1; }

    s.vy += GRAV * dt;
    if (s.vy > 1500) s.vy = 1500;
    s.y += s.vy * dt;
    s.onGround = false;
    for (const p of platforms){
      if (aabb(s, p)){
        if (s.vy > 0){ s.y = p.y - s.h; s.vy = 0; s.onGround = true; }
        else if (s.vy < 0){ s.y = p.y + p.h; s.vy = 0; }
      }
    }

    if (aabb(player, s) && player.invuln <= 0 && s.stun <= 0){
      const dir = (player.x + player.w/2) < (s.x + s.w/2) ? -1 : 1;
      if (player.shielding && player.shieldEnergy > 2){
        player.shieldEnergy = Math.max(0, player.shieldEnergy - 12);
        player.invuln = 0.45;
        s.x -= dir * 46;
        s.vx = -dir * 280;
        s.stun = Math.min(s.stun + 0.8, 1.6);
        addShake(9);
        spawnParticles(player.x + player.w/2 + dir*32, player.y + player.h/2, '#8ef0ff', 22, 340, 0.55, PT.SPARK, { size:2.5 });
        spawnParticles(player.x + player.w/2 + dir*32, player.y + player.h/2, '#ffffff', 10, 200, 0.35, PT.MAGIC);
        spawnFloater(player.x + player.w/2, player.y - 8, 'BLOQUEADO', '#8ef0ff');
        beep(340, 0.12, 'square', 0.06);
        beep(680, 0.09, 'sine', 0.04);
      } else {
        player.hp--;
        player.invuln = 1.3;
        player.vx = dir * -280;
        player.vy = -360;
        player.squash = 0.7;
        addShake(16);
        addFlash('rgba(255,60,60,0.32)', 1);
        spawnParticles(player.x + player.w/2, player.y + player.h/2, '#ff5566', 22, 320, 0.7, PT.EMBER, { size:2.5 });
        spawnParticles(player.x + player.w/2, player.y + player.h/2, '#ffffff', 8, 220, 0.4, PT.SPARK, { size:2 });
        spawnFloater(player.x + player.w/2, player.y - 8, '-1 ❤', '#ff5566');
        beep(140, 0.24, 'sawtooth', 0.07);
        if (player.hp <= 0){ player.hp = 0; endGame('lose'); }
      }
    }
  }
}

/* =========================================================
   PROJÉTEIS
========================================================= */
function updateBolts(dt){
  for (let i = bolts.length - 1; i >= 0; i--){
    const b = bolts[i];
    b.x += b.vx * dt;
    b.y += b.vy * dt;
    b.life -= dt;

    b.trail.push({ x: b.x, y: b.y });
    if (b.trail.length > 14) b.trail.shift();

    if (Math.random() < dt * 70){
      spawnParticles(b.x, b.y, '#c9a0ff', 1, 90, 0.35, PT.MAGIC);
    }
    if (Math.random() < dt * 40){
      spawnParticles(b.x + rand(-3,3), b.y + rand(-3,3), '#ffffff', 1, 40, 0.25, PT.SPARK, { size:1.4 });
    }

    let hit = false;

    for (const s of skeletons){
      if (s.dead || s.stun > 0) continue;
      if (b.x > s.x - 10 && b.x < s.x + s.w + 10 && b.y > s.y - 10 && b.y < s.y + s.h + 10){
        s.stun = STUN_TIME;
        s.vx = 0;
        hit = true;
        addShake(6);
        spawnParticles(s.x + s.w/2, s.y + s.h/2, '#c9a0ff', 30, 340, 0.8, PT.MAGIC);
        spawnParticles(s.x + s.w/2, s.y + s.h/2, '#ffffff', 14, 240, 0.5, PT.SPARK, { size:2 });
        spawnParticles(s.x + s.w/2, s.y + s.h/2, '#c9a0ff', 4, 60, 0.9, PT.RING, { size:1.2 });
        spawnFloater(s.x + s.w/2, s.y - 6, 'PARALISADO!', '#d9b9ff');
        beep(1240, 0.16, 'sawtooth', 0.055);
        setTimeout(() => beep(760, 0.22, 'sawtooth', 0.04), 60);
        break;
      }
    }

    if (!hit){
      for (const p of platforms){
        if (b.x > p.x && b.x < p.x + p.w && b.y > p.y && b.y < p.y + p.h){
          hit = true;
          spawnParticles(b.x, b.y, '#c9a0ff', 14, 220, 0.5, PT.MAGIC);
          spawnParticles(b.x, b.y, '#ffffff', 6, 140, 0.35, PT.SPARK, { size:1.6 });
          break;
        }
      }
    }

    if (hit || b.life <= 0 || b.x < 0 || b.x > WORLD.w){
      if (b.life <= 0 && !hit){
        spawnParticles(b.x, b.y, '#c9a0ff', 12, 180, 0.45, PT.MAGIC);
      }
      bolts.splice(i, 1);
    }
  }
}

/* =========================================================
   AMBIENTE
========================================================= */
function updateAmbient(dt){
  for (const a of ambient){
    a.x += a.vx * dt;
    a.y += a.vy * dt;
    a.phase += dt;
    if (a.y < -10){ a.y = H + 10; a.x = rand(0, W); }
    if (a.x < -10) a.x = W + 10;
    if (a.x > W + 10) a.x = -10;
  }
  for (let i = drips.length - 1; i >= 0; i--){
    const d = drips[i];
    d.life -= dt;
    if (d.life <= 0){
      d.life = rand(2, 5);
      d.x = rand(0, WORLD.w);
      d.y = rand(80, 500);
      d.vy = 0;
    } else if (d.life < 2.4){
      d.vy += 700 * dt;
      d.y += d.vy * dt;
      if (d.y > 900){ d.life = 0; }
    }
  }
}

/* =========================================================
   UPDATE
========================================================= */
function update(dt){
  time += dt;

  if (gameState === 'play'){
    updatePlayer(dt);
    updateMining(dt);
    updateSkeletons(dt);
    updateBolts(dt);
  } else {
    updateBolts(dt);
  }

  updateParticles(dt);
  updateFloaters(dt);
  updateAmbient(dt);

  for (const o of ores){
    if (o.shake > 0) o.shake -= dt;
    o.pulse += dt;
  }

  const tx = clamp(player.x + player.w/2 - W/2, 0, Math.max(0, WORLD.w - W));
  const ty = clamp(player.y + player.h/2 - H/2 + 50, 0, Math.max(0, WORLD.h - H));
  cam.x += (tx - cam.x) * Math.min(1, dt * 7);
  cam.y += (ty - cam.y) * Math.min(1, dt * 6);

  if (shake.t > 0){
    shake.t -= dt * 3.2;
    if (shake.t < 0){ shake.t = 0; shake.m = 0; }
  }
  if (flash.t > 0) flash.t -= dt * 2.5;

  updateHUD();
}

/* =========================================================
   RENDER -- FUNDO
========================================================= */
function drawBackground(){
  const g = ctx.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, '#050810');
  g.addColorStop(0.42, '#0a1020');
  g.addColorStop(0.75, '#0f1729');
  g.addColorStop(1, '#141d33');
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, W, H);

  const rg = ctx.createRadialGradient(W*0.5, H*1.15, 30, W*0.5, H*1.15, H*1.1);
  rg.addColorStop(0, 'rgba(70,120,200,0.22)');
  rg.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = rg;
  ctx.fillRect(0, 0, W, H);
}

function drawFarCave(){
  const off = cam.x * 0.18;
  const span = W + 500;

  ctx.fillStyle = 'rgba(4,7,13,0.95)';
  for (let i = 0; i < 40; i++){
    let x = ((i * 197 - off) % span + span) % span - 250;
    const h = 80 + ((i * 113) % 160);
    const w = 46 + ((i * 61) % 46);
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x + w, 0);
    ctx.lineTo(x + w/2, h);
    ctx.closePath();
    ctx.fill();
  }

  const off2 = cam.x * 0.3;
  ctx.fillStyle = 'rgba(6,10,17,0.95)';
  for (let i = 0; i < 32; i++){
    let x = ((i * 241 - off2) % span + span) % span - 250;
    const h = 90 + ((i * 149) % 140);
    const w = 58 + ((i * 83) % 56);
    const baseY = H * 0.92;
    ctx.beginPath();
    ctx.moveTo(x, baseY);
    ctx.lineTo(x + w, baseY);
    ctx.lineTo(x + w/2, baseY - h);
    ctx.closePath();
    ctx.fill();
  }
}

function drawMidCave(){
  const off = cam.x * 0.42;
  const span = W + 600;

  for (const d of decor){
    if (d.type !== 'crystal') continue;
    const px = d.x - off;
    const rx = ((px % span) + span) % span - 300;
    if (rx < -50 || rx > W + 50) continue;

    const y = d.y + Math.sin(time * 0.6 + d.phase) * 6;
    const s = d.s;
    const glow = 0.35 + 0.35 * Math.sin(time * 1.4 + d.phase);
    const color = `hsl(${d.hue}, 80%, ${55 + glow * 12}%)`;

    ctx.save();
    ctx.shadowColor = color;
    ctx.shadowBlur = 24 * glow;
    ctx.globalAlpha = 0.55 + glow * 0.35;

    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(rx, y - 30 * s);
    ctx.lineTo(rx + 10 * s, y);
    ctx.lineTo(rx, y + 34 * s);
    ctx.lineTo(rx - 10 * s, y);
    ctx.closePath();
    ctx.fill();

    ctx.globalAlpha = 0.9;
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.beginPath();
    ctx.moveTo(rx - 1 * s, y - 24 * s);
    ctx.lineTo(rx + 3 * s, y - 6 * s);
    ctx.lineTo(rx - 1 * s, y + 4 * s);
    ctx.closePath();
    ctx.fill();

    ctx.restore();
  }
}

/* =========================================================
   RENDER -- PLATAFORMAS
========================================================= */
function drawPlatforms(){
  for (const p of platforms){
    if (p.x + p.w < cam.x - 100 || p.x > cam.x + W + 100) continue;

    const visibleH = Math.min(p.h, 280);
    const g = ctx.createLinearGradient(0, p.y, 0, p.y + visibleH);
    g.addColorStop(0, '#47506a');
    g.addColorStop(0.06, '#3a4257');
    g.addColorStop(0.35, '#232a3a');
    g.addColorStop(1, '#0e1320');
    ctx.fillStyle = g;
    ctx.fillRect(p.x, p.y, p.w, p.h);

    ctx.fillStyle = '#6b7695';
    ctx.fillRect(p.x, p.y, p.w, 5);
    ctx.fillStyle = 'rgba(180,220,255,0.28)';
    ctx.fillRect(p.x, p.y, p.w, 2);
    ctx.fillStyle = 'rgba(120,180,255,0.10)';
    ctx.fillRect(p.x, p.y + 5, p.w, 3);

    ctx.fillStyle = 'rgba(0,0,0,0.24)';
    const step = 78;
    const startX = Math.floor(p.x / step) * step;
    for (let x = startX; x < p.x + p.w; x += step){
      const seed = ((x * 9301 + p.y * 49297) % 233280) / 233280;
      const rx = x + seed * 42;
      const ry = p.y + 16 + seed * Math.min(p.h - 34, 130);
      if (ry > p.y + p.h - 10) continue;
      ctx.beginPath();
      ctx.ellipse(rx, ry, 10 + seed * 14, 4 + seed * 6, seed * 3, 0, 7);
      ctx.fill();
    }

    ctx.fillStyle = 'rgba(0,0,0,0.45)';
    ctx.fillRect(p.x, p.y + p.h - 5, p.w, 5);

    for (let x = p.x + 8; x < p.x + p.w - 8; x += 26){
      const seed = ((x * 4127 + p.y * 1289) % 841) / 841;
      if (seed > 0.35){
        const alpha = 0.25 + 0.25 * Math.sin(time * 1.2 + seed * 20);
        ctx.fillStyle = `rgba(90,220,180,${alpha * 0.7})`;
        ctx.beginPath();
        ctx.ellipse(x, p.y + 1, 3 + seed * 3, 1.8, 0, 0, 7);
        ctx.fill();
      }
    }
  }
}

/* =========================================================
   RENDER -- DECORAÇÃO
========================================================= */
function drawDecor(){
  for (const d of decor){
    if (d.type === 'bone'){
      const x = d.x, y = d.y;
      if (x < cam.x - 60 || x > cam.x + W + 60) continue;
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(d.rot);
      ctx.scale(d.s, d.s);
      ctx.fillStyle = 'rgba(150,150,140,0.28)';
      roundRect(ctx, -18, -3, 36, 6, 3);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(-18, 0, 4.5, 0, 7);
      ctx.arc(18, 0, 4.5, 0, 7);
      ctx.fill();
      ctx.restore();
    }
  }
  for (const d of decor){
    if (d.type !== 'mushroom') continue;
    const x = d.x, y = d.y;
    if (x < cam.x - 40 || x > cam.x + W + 40) continue;
    const pulse = 0.65 + 0.35 * Math.sin(time * 1.8 + d.phase);
    const s = d.s;
    ctx.save();
    ctx.translate(x, y);
    ctx.fillStyle = '#3a4250';
    ctx.fillRect(-1.6 * s, -10 * s, 3.2 * s, 10 * s);
    const color = `hsl(${d.hue}, 75%, 60%)`;
    ctx.shadowColor = color;
    ctx.shadowBlur = 18 * pulse;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.ellipse(0, -11 * s, 8 * s, 5.5 * s, 0, Math.PI, 0);
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.beginPath();
    ctx.arc(-2.5 * s, -12 * s, 1.2 * s, 0, 7);
    ctx.arc(2.5 * s, -13 * s, 1.0 * s, 0, 7);
    ctx.fill();
    ctx.restore();
  }
  for (const d of decor){
    if (d.type !== 'rock') continue;
    const x = d.x, y = d.y;
    if (x < cam.x - 80 || x > cam.x + W + 80) continue;
    ctx.save();
    ctx.translate(x, y);
    const s = d.s;
    ctx.fillStyle = 'rgba(15,22,36,0.8)';
    ctx.beginPath();
    ctx.moveTo(-30 * s, 0);
    ctx.lineTo(-18 * s, -22 * s);
    ctx.lineTo(-2 * s, -30 * s);
    ctx.lineTo(16 * s, -24 * s);
    ctx.lineTo(30 * s, -6 * s);
    ctx.lineTo(28 * s, 0);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = 'rgba(90,130,190,0.18)';
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.restore();
  }
}

/* =========================================================
   RENDER -- MINÉRIOS
========================================================= */
function drawOres(){
  for (const o of ores){
    if (o.done) continue;
    if (o.x + o.w < cam.x - 80 || o.x > cam.x + W + 80) continue;

    const t = ORE_TYPES[o.type];
    const sh = o.shake > 0 ? rand(-3, 3) : 0;
    const cx = o.x + o.w / 2, cy = o.y + o.h / 2;
    const pulse = 0.7 + 0.3 * Math.sin(time * 3 + o.pulse);
    const s = o.w / 50;

    ctx.save();
    ctx.translate(sh + cx, cy);
    ctx.scale(s, s);

    ctx.globalAlpha = 0.4 * pulse * t.glow;
    const aura = ctx.createRadialGradient(0, 0, 4, 0, 0, 50);
    aura.addColorStop(0, t.light);
    aura.addColorStop(0.5, t.color);
    aura.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = aura;
    ctx.beginPath();
    ctx.arc(0, 0, 50, 0, 7);
    ctx.fill();
    ctx.globalAlpha = 1;

    const baseGrad = ctx.createLinearGradient(-25, -25, 25, 25);
    baseGrad.addColorStop(0, '#3d4557');
    baseGrad.addColorStop(0.5, '#262c3a');
    baseGrad.addColorStop(1, '#12161f');
    ctx.fillStyle = baseGrad;
    roundRect(ctx, -25, -25, 50, 50, 11);
    ctx.fill();

    ctx.strokeStyle = 'rgba(140,160,200,0.35)';
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(-22, -22);
    ctx.quadraticCurveTo(0, -25, 22, -22);
    ctx.stroke();

    ctx.strokeStyle = 'rgba(0,0,0,0.55)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(-22, 22);
    ctx.quadraticCurveTo(0, 25, 22, 22);
    ctx.stroke();

    ctx.strokeStyle = 'rgba(90,105,135,0.6)';
    ctx.lineWidth = 1.6;
    roundRect(ctx, -25, -25, 50, 50, 11);
    ctx.stroke();

    ctx.shadowColor = t.color;
    ctx.shadowBlur = 20 * pulse * t.glow;

    ctx.fillStyle = t.color;
    ctx.beginPath();
    ctx.moveTo(-14, -14);
    ctx.lineTo(-6, -18);
    ctx.lineTo(-2, -6);
    ctx.lineTo(-10, 4);
    ctx.lineTo(-16, -4);
    ctx.closePath();
    ctx.fill();

    ctx.shadowBlur = 0;
    const facetL = ctx.createLinearGradient(-14, -18, -4, 4);
    facetL.addColorStop(0, t.light);
    facetL.addColorStop(1, t.color);
    ctx.fillStyle = facetL;
    ctx.beginPath();
    ctx.moveTo(-14, -14);
    ctx.lineTo(-6, -18);
    ctx.lineTo(-8, -8);
    ctx.lineTo(-14, -4);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = t.dark;
    ctx.globalAlpha = 0.7;
    ctx.beginPath();
    ctx.moveTo(-10, 4);
    ctx.lineTo(-2, -6);
    ctx.lineTo(-4, 0);
    ctx.lineTo(-8, 4);
    ctx.closePath();
    ctx.fill();
    ctx.globalAlpha = 1;

    ctx.shadowBlur = 20 * pulse * t.glow;
    ctx.fillStyle = t.color;
    ctx.beginPath();
    ctx.moveTo(14, -10);
    ctx.lineTo(20, -2);
    ctx.lineTo(14, 12);
    ctx.lineTo(6, 6);
    ctx.lineTo(8, -6);
    ctx.closePath();
    ctx.fill();

    ctx.shadowBlur = 0;
    const facetR = ctx.createLinearGradient(8, -10, 20, 12);
    facetR.addColorStop(0, t.light);
    facetR.addColorStop(1, t.color);
    ctx.fillStyle = facetR;
    ctx.beginPath();
    ctx.moveTo(14, -10);
    ctx.lineTo(20, -2);
    ctx.lineTo(15, 2);
    ctx.lineTo(10, -4);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = t.dark;
    ctx.globalAlpha = 0.65;
    ctx.beginPath();
    ctx.moveTo(14, 12);
    ctx.lineTo(6, 6);
    ctx.lineTo(11, 6);
    ctx.lineTo(14, 8);
    ctx.closePath();
    ctx.fill();
    ctx.globalAlpha = 1;

    ctx.shadowBlur = 20 * pulse * t.glow;
    ctx.fillStyle = t.color;
    ctx.beginPath();
    ctx.moveTo(-4, 8);
    ctx.lineTo(4, 6);
    ctx.lineTo(6, 16);
    ctx.lineTo(-2, 18);
    ctx.closePath();
    ctx.fill();

    ctx.shadowBlur = 0;
    const facetS = ctx.createLinearGradient(-4, 6, 6, 18);
    facetS.addColorStop(0, t.light);
    facetS.addColorStop(1, t.color);
    ctx.fillStyle = facetS;
    ctx.beginPath();
    ctx.moveTo(-4, 8);
    ctx.lineTo(4, 6);
    ctx.lineTo(2, 12);
    ctx.lineTo(-3, 13);
    ctx.closePath();
    ctx.fill();

    ctx.shadowBlur = 0;
    ctx.fillStyle = 'rgba(255,255,255,0.95)';
    ctx.beginPath();
    ctx.arc(-12, -13, 1.6, 0, 7);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(15, -7, 1.4, 0, 7);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(-2, 9, 1.2, 0, 7);
    ctx.fill();

    ctx.strokeStyle = 'rgba(255,255,255,0.55)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(-13, -13);
    ctx.lineTo(-8, -9);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(14, -8);
    ctx.lineTo(18, -3);
    ctx.stroke();

    const dmg = 1 - Math.max(0, o.hp) / o.maxHp;
    if (dmg > 0.18){
      ctx.strokeStyle = 'rgba(0,0,0,0.8)';
      ctx.lineWidth = 1.8;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(-22, -18);
      ctx.lineTo(-10, -12);
      ctx.lineTo(-8, -2);
      ctx.lineTo(-14, 6);
      ctx.stroke();
    }
    if (dmg > 0.45){
      ctx.beginPath();
      ctx.moveTo(22, -14);
      ctx.lineTo(14, -6);
      ctx.lineTo(16, 4);
      ctx.lineTo(8, 12);
      ctx.stroke();
    }
    if (dmg > 0.72){
      ctx.beginPath();
      ctx.moveTo(-4, -22);
      ctx.lineTo(2, -10);
      ctx.lineTo(-2, 2);
      ctx.lineTo(4, 14);
      ctx.stroke();
    }

    if (dmg > 0.4 && Math.random() < 0.09){
      const a = Math.random() * Math.PI * 2;
      const r = 26 + Math.random() * 8;
      const wx = cx + Math.cos(a) * r * s;
      const wy = cy + Math.sin(a) * r * s;
      spawnParticles(wx, wy, t.light, 1, 10, 0.6, PT.EMBER, { size:1.6, grav:0 });
    }

    ctx.restore();
  }
}

/* =========================================================
   RENDER -- ESQUELETOS (ULTRA DETALHADOS)
========================================================= */
function drawSkeletons(){
  for (const s of skeletons){
    if (s.x + s.w < cam.x - 100 || s.x > cam.x + W + 100) continue;

    const flash = s.hitFlash > 0;
    const stunned = s.stun > 0;
    const breath = Math.sin(time * 2 + s.breathPhase) * 0.5 + 0.5;
    const walk = stunned ? 0 : Math.sin(s.anim * 9) * 4;
    const armSwing = stunned ? 0 : Math.sin(s.anim * 9) * 5;
    const headBob = stunned ? 0 : Math.sin(s.anim * 9) * 1.4;

    // Cores base com variação por tipo
    let bone, boneShade, boneHighlight;
    if (flash){
      bone = '#ffb0b0'; boneShade = '#c07070'; boneHighlight = '#ffdada';
    } else if (stunned){
      bone = '#d8ecff'; boneShade = '#94b8dd'; boneHighlight = '#ffffff';
    } else {
      // Ossos com leve tom amarelado (mais antigo) ou esverdeado
      if (s.type === 'mage'){
        bone = '#dcd6e8'; boneShade = '#8a7fa0'; boneHighlight = '#f0e8ff';
      } else if (s.type === 'guardian'){
        bone = '#e8d8c0'; boneShade = '#a08060'; boneHighlight = '#ffeedd';
      } else if (s.type === 'archer'){
        bone = '#e0e4d4'; boneShade = '#909880'; boneHighlight = '#f8ffe8';
      } else {
        bone = '#eee9d8'; boneShade = '#a89e7f'; boneHighlight = '#fffbe8';
      }
    }

    ctx.save();
    ctx.translate(s.x + s.w / 2, s.y + s.h);
    ctx.scale(s.dir * s.scale, s.scale);

    // === SOMBRA NO CHÃO ===
    ctx.globalAlpha = 0.38;
    ctx.fillStyle = '#000';
    ctx.beginPath();
    ctx.ellipse(0, 2, 18, 5.5, 0, 0, 7);
    ctx.fill();
    ctx.globalAlpha = 1;

    // === AURA DE STUN ===
    if (stunned){
      const aura = ctx.createRadialGradient(0, -30, 6, 0, -30, 55);
      const p = 0.6 + 0.4 * Math.sin(time * 8);
      aura.addColorStop(0, `rgba(180,140,255,${0.4 * p})`);
      aura.addColorStop(0.6, `rgba(140,100,220,${0.2 * p})`);
      aura.addColorStop(1, 'rgba(180,140,255,0)');
      ctx.fillStyle = aura;
      ctx.beginPath();
      ctx.arc(0, -30, 55, 0, 7);
      ctx.fill();
    }

    // === AURA DE TIPO (sempre presente, sutil) ===
    if (!stunned && !flash){
      const typeAura = ctx.createRadialGradient(0, -30, 4, 0, -30, 42);
      let auraCol;
      if (s.type === 'mage') auraCol = '180,120,255';
      else if (s.type === 'guardian') auraCol = '255,140,60';
      else if (s.type === 'archer') auraCol = '120,220,255';
      else auraCol = '255,80,60';
      const ap = 0.12 + 0.06 * Math.sin(time * 2 + s.auraPulse);
      typeAura.addColorStop(0, `rgba(${auraCol},${ap * 1.5})`);
      typeAura.addColorStop(1, `rgba(${auraCol},0)`);
      ctx.fillStyle = typeAura;
      ctx.beginPath();
      ctx.arc(0, -30, 42, 0, 7);
      ctx.fill();
    }

    // === CAPA/TÚNICA RASGADA (atrás do corpo) ===
    if (s.type === 'mage' || s.type === 'guardian' || Math.random() < 0.5){
      drawTatteredCloak(ctx, s, breath, walk, boneShade);
    }

    // === PERNAS (fêmur + tíbia + articulações) ===
    drawLeg(ctx, -5, -22, -6 - walk, -2, bone, boneShade, boneHighlight, s.type);
    drawLeg(ctx,  5, -22,  6 + walk, -2, bone, boneShade, boneHighlight, s.type);

    // === PÉS ===
    ctx.fillStyle = bone;
    ctx.strokeStyle = boneShade;
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.ellipse(-6 - walk, -1, 5, 2.2, 0, 0, 7);
    ctx.fill(); ctx.stroke();
    ctx.beginPath();
    ctx.ellipse(6 + walk, -1, 5, 2.2, 0, 0, 7);
    ctx.fill(); ctx.stroke();

    // === PELVE ===
    ctx.fillStyle = bone;
    ctx.beginPath();
    ctx.moveTo(-9, -22);
    ctx.quadraticCurveTo(0, -26, 9, -22);
    ctx.lineTo(7, -18);
    ctx.quadraticCurveTo(0, -20, -7, -18);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = boneShade;
    ctx.lineWidth = 1;
    ctx.stroke();

    // === COLUNA VERTEBRAL (vértebras individuais) ===
    for (let i = 0; i < 6; i++){
      const vy = -24 - i * 4;
      const vx = Math.sin(s.anim * 9 + i * 0.4) * 0.4;
      // Sombra da vértebra
      ctx.fillStyle = boneShade;
      ctx.beginPath();
      ctx.arc(vx + 0.6, vy + 0.6, 2.8, 0, 7);
      ctx.fill();
      // Vértebra
      ctx.fillStyle = bone;
      ctx.beginPath();
      ctx.arc(vx, vy, 2.8, 0, 7);
      ctx.fill();
      // Brilho
      ctx.fillStyle = boneHighlight;
      ctx.globalAlpha = 0.7;
      ctx.beginPath();
      ctx.arc(vx - 0.8, vy - 0.8, 1.2, 0, 7);
      ctx.fill();
      ctx.globalAlpha = 1;
      // Espinhos laterais
      ctx.fillStyle = boneShade;
      ctx.beginPath();
      ctx.moveTo(vx - 2.8, vy);
      ctx.lineTo(vx - 4.5, vy - 1);
      ctx.lineTo(vx - 3.5, vy + 1.5);
      ctx.closePath();
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(vx + 2.8, vy);
      ctx.lineTo(vx + 4.5, vy - 1);
      ctx.lineTo(vx + 3.5, vy + 1.5);
      ctx.closePath();
      ctx.fill();
    }

    // === COSTELAS (arcos) com runas brilhantes ===
    for (let i = 0; i < 3; i++){
      const yy = -27 - i * 5;
      const rr = 8 - i * 0.8;
      // Sombra
      ctx.strokeStyle = boneShade;
      ctx.lineWidth = 3.8;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(-rr + 1, yy + 0.6);
      ctx.quadraticCurveTo(0, yy + 2.6, rr - 1, yy + 0.6);
      ctx.stroke();
      // Osso
      ctx.strokeStyle = bone;
      ctx.lineWidth = 3.2;
      ctx.beginPath();
      ctx.moveTo(-rr, yy);
      ctx.quadraticCurveTo(0, yy + 2, rr, yy);
      ctx.stroke();
      // Brilho
      ctx.strokeStyle = boneHighlight;
      ctx.lineWidth = 0.9;
      ctx.beginPath();
      ctx.moveTo(-rr * 0.7, yy - 0.6);
      ctx.quadraticCurveTo(0, yy + 1.2, rr * 0.7, yy - 0.6);
      ctx.stroke();

      // Runa brilhante no meio da costela
      const runeGlow = 0.5 + 0.5 * Math.sin(time * 3 + s.runePhase + i);
      ctx.save();
      ctx.shadowColor = `hsl(${s.runeHue}, 100%, 65%)`;
      ctx.shadowBlur = 10 * runeGlow;
      ctx.fillStyle = `hsla(${s.runeHue}, 100%, 75%, ${0.7 + 0.3 * runeGlow})`;
      ctx.beginPath();
      ctx.arc(0, yy + 1, 1.3, 0, 7);
      ctx.fill();
      ctx.restore();
    }

    // === BRAÇOS (úmero + rádio/ulna) com mãos detalhadas ===
    // Braço de trás
    drawArm(ctx, 0, -40, -12, -28 + armSwing, bone, boneShade, boneHighlight, -1, s.type);
    // Braço da frente
    drawArm(ctx, 0, -40,  13, -30 - armSwing, bone, boneShade, boneHighlight, 1, s.type);

    // === CRÂNIO (altamente detalhado) ===
    ctx.save();
    ctx.translate(0, -50 + headBob);

    // Sombra do crânio
    ctx.fillStyle = 'rgba(0,0,0,0.35)';
    ctx.beginPath();
    ctx.ellipse(1, 1, 10.5, 11, 0, 0, 7);
    ctx.fill();

    // Caixa craniana (com gradiente)
    const skullGrad = ctx.createRadialGradient(-3, -3, 2, 0, 0, 12);
    skullGrad.addColorStop(0, boneHighlight);
    skullGrad.addColorStop(0.5, bone);
    skullGrad.addColorStop(1, boneShade);
    ctx.fillStyle = skullGrad;
    ctx.beginPath();
    ctx.ellipse(0, 0, 10.5, 11, 0, 0, 7);
    ctx.fill();

    // Contorno do crânio
    ctx.strokeStyle = boneShade;
    ctx.lineWidth = 0.8;
    ctx.stroke();

    // Suturas cranianas (linhas finas)
    ctx.strokeStyle = 'rgba(120,110,90,0.55)';
    ctx.lineWidth = 0.7;
    ctx.beginPath();
    ctx.moveTo(-2, -9);
    ctx.quadraticCurveTo(-4, -5, -3, -1);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(3, -9);
    ctx.quadraticCurveTo(5, -5, 4, -1);
    ctx.stroke();

    // Maçãs do rosto
    ctx.fillStyle = boneShade;
    ctx.globalAlpha = 0.4;
    ctx.beginPath();
    ctx.ellipse(-6, 2, 2.6, 1.6, 0.2, 0, 7);
    ctx.fill();
    ctx.beginPath();
    ctx.ellipse(6, 2, 2.6, 1.6, -0.2, 0, 7);
    ctx.fill();
    ctx.globalAlpha = 1;

    // Maxilar
    ctx.fillStyle = bone;
    ctx.beginPath();
    ctx.moveTo(-7, 5);
    ctx.lineTo(-7, 10);
    ctx.quadraticCurveTo(0, 12.5, 7, 10);
    ctx.lineTo(7, 5);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = boneShade;
    ctx.lineWidth = 0.7;
    ctx.stroke();

    // Linha do maxilar (separação)
    ctx.strokeStyle = 'rgba(80,70,50,0.6)';
    ctx.lineWidth = 0.6;
    ctx.beginPath();
    ctx.moveTo(-6.5, 6);
    ctx.quadraticCurveTo(0, 7, 6.5, 6);
    ctx.stroke();

    // === DENTES (individualizados) ===
    for (let i = -3; i <= 3; i++){
      const dx = i * 2;
      const toothH = 2.6 + (i % 2) * 0.4;
      // Sombra do dente
      ctx.fillStyle = 'rgba(60,50,35,0.5)';
      ctx.fillRect(dx - 0.9 + 0.3, 6.7 + 0.3, 1.8, toothH);
      // Dente
      ctx.fillStyle = boneHighlight;
      ctx.fillRect(dx - 0.9, 6.7, 1.8, toothH);
      // Brilho
      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.fillRect(dx - 0.7, 6.9, 0.6, 1);
    }

    // === CAVIDADES OCULARES (fundas) ===
    // Órbita esquerda
    const socketGradL = ctx.createRadialGradient(-4, -2, 0.5, -4, -2, 4.5);
    socketGradL.addColorStop(0, '#000000');
    socketGradL.addColorStop(0.7, '#0a0e16');
    socketGradL.addColorStop(1, 'rgba(20,30,50,0.6)');
    ctx.fillStyle = socketGradL;
    ctx.beginPath();
    ctx.ellipse(-4, -2.5, 4, 4.6, -0.15, 0, 7);
    ctx.fill();
    // Órbita direita
    const socketGradR = ctx.createRadialGradient(4, -2, 0.5, 4, -2, 4.5);
    socketGradR.addColorStop(0, '#000000');
    socketGradR.addColorStop(0.7, '#0a0e16');
    socketGradR.addColorStop(1, 'rgba(20,30,50,0.6)');
    ctx.fillStyle = socketGradR;
    ctx.beginPath();
    ctx.ellipse(4, -2.5, 4, 4.6, 0.15, 0, 7);
    ctx.fill();

    // === OLHOS BRILHANTES (com pupila e brilho pulsante) ===
    if (!stunned && s.blink <= 0){
      const eyePulse = 0.7 + 0.3 * Math.sin(time * 5 + s.anim);
      const eyeCol = flash ? '#ffffff' : s.eyeColor;

      // Glow externo
      ctx.save();
      ctx.shadowColor = eyeCol;
      ctx.shadowBlur = 16;
      const eyeGlowL = ctx.createRadialGradient(-4, -2.5, 0.3, -4, -2.5, 3.5);
      eyeGlowL.addColorStop(0, '#ffffff');
      eyeGlowL.addColorStop(0.4, eyeCol);
      eyeGlowL.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = eyeGlowL;
      ctx.beginPath();
      ctx.arc(-4, -2.5, 3, 0, 7);
      ctx.fill();

      const eyeGlowR = ctx.createRadialGradient(4, -2.5, 0.3, 4, -2.5, 3.5);
      eyeGlowR.addColorStop(0, '#ffffff');
      eyeGlowR.addColorStop(0.4, eyeCol);
      eyeGlowR.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = eyeGlowR;
      ctx.beginPath();
      ctx.arc(4, -2.5, 3, 0, 7);
      ctx.fill();
      ctx.restore();

      // Pupila
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(-4, -2.5, 1.2 * eyePulse, 0, 7);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(4, -2.5, 1.2 * eyePulse, 0, 7);
      ctx.fill();
    } else if (stunned){
      // Olhos X quando paralisado
      ctx.strokeStyle = '#7fe9ff';
      ctx.lineWidth = 1.6;
      ctx.shadowColor = '#7fe9ff';
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.moveTo(-6, -4); ctx.lineTo(-2, -1);
      ctx.moveTo(-2, -4); ctx.lineTo(-6, -1);
      ctx.moveTo(2, -4);  ctx.lineTo(6, -1);
      ctx.moveTo(6, -4);  ctx.lineTo(2, -1);
      ctx.stroke();
      ctx.shadowBlur = 0;
    }

    // === NARIZ (cavidade) ===
    ctx.fillStyle = '#0a0e16';
    ctx.beginPath();
    ctx.moveTo(0, 0.5);
    ctx.lineTo(-1.8, 4);
    ctx.lineTo(1.8, 4);
    ctx.closePath();
    ctx.fill();
    // Brilho da cavidade
    ctx.fillStyle = 'rgba(60,80,120,0.5)';
    ctx.beginPath();
    ctx.moveTo(0, 1);
    ctx.lineTo(-0.8, 3.2);
    ctx.lineTo(0.8, 3.2);
    ctx.closePath();
    ctx.fill();

    // === COROA/RUNAS NO CRÂNIO (por tipo) ===
    if (s.type === 'mage' || s.type === 'guardian'){
      // Coroa mágica brilhante
      const crownGlow = 0.6 + 0.4 * Math.sin(time * 3 + s.runePhase);
      ctx.save();
      ctx.shadowColor = `hsl(${s.runeHue}, 100%, 70%)`;
      ctx.shadowBlur = 12 * crownGlow;
      ctx.strokeStyle = `hsla(${s.runeHue}, 100%, 75%, ${0.85})`;
      ctx.lineWidth = 1.4;
      // Coroa de 5 pontas
      ctx.beginPath();
      for (let i = -2; i <= 2; i++){
        const px = i * 3;
        ctx.moveTo(px, -9);
        ctx.lineTo(px, -12);
      }
      ctx.stroke();
      // Runas entre as pontas
      for (let i = -1; i <= 1; i++){
        ctx.fillStyle = `hsla(${s.runeHue}, 100%, 80%, ${0.9 * crownGlow})`;
        ctx.beginPath();
        ctx.arc(i * 4, -10.5, 1, 0, 7);
        ctx.fill();
      }
      ctx.restore();
    }
    // Chifres pequenos para guardião
    if (s.type === 'guardian'){
      ctx.fillStyle = bone;
      ctx.strokeStyle = boneShade;
      ctx.lineWidth = 0.8;
      // Chifre esquerdo
      ctx.beginPath();
      ctx.moveTo(-8, -8);
      ctx.quadraticCurveTo(-12, -14, -10, -17);
      ctx.quadraticCurveTo(-9, -14, -6, -9);
      ctx.closePath();
      ctx.fill(); ctx.stroke();
      // Chifre direito
      ctx.beginPath();
      ctx.moveTo(8, -8);
      ctx.quadraticCurveTo(12, -14, 10, -17);
      ctx.quadraticCurveTo(9, -14, 6, -9);
      ctx.closePath();
      ctx.fill(); ctx.stroke();
    }

    ctx.restore(); // fim crânio

    // === ARMA POR TIPO ===
    drawSkeletonWeapon(ctx, s, armSwing, bone, boneShade, boneHighlight);

    ctx.restore();

    // === ARCOS ELÉTRICOS QUANDO PARALISADO ===
    if (stunned){
      ctx.save();
      ctx.shadowColor = '#b48cff';
      ctx.shadowBlur = 14;
      const cx = s.x + s.w / 2, cy = s.y + s.h / 2;
      for (let k = 0; k < 4; k++){
        ctx.strokeStyle = `rgba(200,160,255,${0.6 + Math.random() * 0.4})`;
        ctx.lineWidth = 2;
        ctx.beginPath();
        const a0 = time * 7 + k * 1.7;
        let lx = cx + Math.cos(a0) * 28;
        let ly = cy + Math.sin(a0 * 1.3) * 32;
        ctx.moveTo(lx, ly);
        for (let seg = 0; seg < 4; seg++){
          lx += (Math.random() - 0.5) * 20;
          ly += (Math.random() - 0.5) * 20;
          ctx.lineTo(lx, ly);
        }
        ctx.stroke();
      }
      ctx.restore();

      const bw = s.w + 6;
      ctx.fillStyle = 'rgba(0,0,0,0.55)';
      roundRect(ctx, s.x - 3, s.y - 14, bw, 6, 3);
      ctx.fill();
      const stGrad = ctx.createLinearGradient(s.x, 0, s.x + bw, 0);
      stGrad.addColorStop(0, '#b48cff');
      stGrad.addColorStop(1, '#e0c7ff');
      ctx.fillStyle = stGrad;
      ctx.shadowColor = '#b48cff';
      ctx.shadowBlur = 8;
      roundRect(ctx, s.x - 2, s.y - 13, (bw - 2) * (s.stun / STUN_TIME), 4, 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    // === BARRA DE VIDA ===
    if (s.hp < s.maxHp && !stunned){
      const bw = s.w + 6;
      ctx.fillStyle = 'rgba(0,0,0,0.55)';
      roundRect(ctx, s.x - 3, s.y - 14, bw, 6, 3);
      ctx.fill();
      const hpGrad = ctx.createLinearGradient(s.x, 0, s.x + bw, 0);
      hpGrad.addColorStop(0, '#ff3a55');
      hpGrad.addColorStop(1, '#ff8a6e');
      ctx.fillStyle = hpGrad;
      ctx.shadowColor = '#ff5a6e';
      ctx.shadowBlur = 8;
      roundRect(ctx, s.x - 2, s.y - 13, (bw - 2) * (s.hp / s.maxHp), 4, 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }
  }
}

/* ---------- Helpers de desenho dos esqueletos ---------- */

function drawLeg(ctx, x0, y0, x1, y1, bone, boneShade, boneHighlight, type){
  // Fêmur
  ctx.strokeStyle = boneShade;
  ctx.lineWidth = 6;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(x0 + 0.7, y0 + 0.7);
  ctx.lineTo(x1 + 0.7, y1 + 0.7);
  ctx.stroke();
  ctx.strokeStyle = bone;
  ctx.lineWidth = 5;
  ctx.beginPath();
  ctx.moveTo(x0, y0);
  ctx.lineTo(x1, y1);
  ctx.stroke();
  // Brilho
  ctx.strokeStyle = boneHighlight;
  ctx.lineWidth = 1.4;
  ctx.globalAlpha = 0.65;
  ctx.beginPath();
  ctx.moveTo(x0 - 1, y0 - 1);
  ctx.lineTo(x1 - 1, y1 - 1);
  ctx.stroke();
  ctx.globalAlpha = 1;

  // Articulação do joelho
  ctx.fillStyle = boneShade;
  ctx.beginPath();
  ctx.arc(x1 + 0.5, y1 + 0.5, 3.4, 0, 7);
  ctx.fill();
  ctx.fillStyle = bone;
  ctx.beginPath();
  ctx.arc(x1, y1, 3, 0, 7);
  ctx.fill();
  ctx.fillStyle = boneHighlight;
  ctx.beginPath();
  ctx.arc(x1 - 0.8, y1 - 0.8, 1.2, 0, 7);
  ctx.fill();

  // Tíbia
  const kneeX = x1, kneeY = y1;
  const ankleX = x1 + (x1 - x0) * 0.25;
  const ankleY = y1 - 2;
  ctx.strokeStyle = boneShade;
  ctx.lineWidth = 5;
  ctx.beginPath();
  ctx.moveTo(kneeX + 0.5, kneeY + 0.5);
  ctx.lineTo(ankleX + 0.5, ankleY + 0.5);
  ctx.stroke();
  ctx.strokeStyle = bone;
  ctx.lineWidth = 4;
  ctx.beginPath();
  ctx.moveTo(kneeX, kneeY);
  ctx.lineTo(ankleX, ankleY);
  ctx.stroke();
}

function drawArm(ctx, x0, y0, x1, y1, bone, boneShade, boneHighlight, side, type){
  // Úmero
  ctx.strokeStyle = boneShade;
  ctx.lineWidth = 5.5;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(x0 + 0.6, y0 + 0.6);
  ctx.lineTo(x1 + 0.6, y1 + 0.6);
  ctx.stroke();
  ctx.strokeStyle = bone;
  ctx.lineWidth = 4.5;
  ctx.beginPath();
  ctx.moveTo(x0, y0);
  ctx.lineTo(x1, y1);
  ctx.stroke();
  // Brilho
  ctx.strokeStyle = boneHighlight;
  ctx.lineWidth = 1.2;
  ctx.globalAlpha = 0.6;
  ctx.beginPath();
  ctx.moveTo(x0 - 0.8, y0 - 0.8);
  ctx.lineTo(x1 - 0.8, y1 - 0.8);
  ctx.stroke();
  ctx.globalAlpha = 1;

  // Cotovelo
  ctx.fillStyle = boneShade;
  ctx.beginPath();
  ctx.arc(x1 + 0.5, y1 + 0.5, 2.8, 0, 7);
  ctx.fill();
  ctx.fillStyle = bone;
  ctx.beginPath();
  ctx.arc(x1, y1, 2.4, 0, 7);
  ctx.fill();
  ctx.fillStyle = boneHighlight;
  ctx.beginPath();
  ctx.arc(x1 - 0.6, y1 - 0.6, 1, 0, 7);
  ctx.fill();

  // Antebraço (continua na mesma direção, com leve angulação)
  const fx = x1 + (x1 - x0) * 0.7;
  const fy = y1 + (y1 - y0) * 0.7 + 4;
  ctx.strokeStyle = boneShade;
  ctx.lineWidth = 4.5;
  ctx.beginPath();
  ctx.moveTo(x1 + 0.4, y1 + 0.4);
  ctx.lineTo(fx + 0.4, fy + 0.4);
  ctx.stroke();
  ctx.strokeStyle = bone;
  ctx.lineWidth = 3.5;
  ctx.beginPath();
  ctx.moveTo(x1, y1);
  ctx.lineTo(fx, fy);
  ctx.stroke();

  // Mão (pequenos dedos)
  ctx.strokeStyle = bone;
  ctx.lineWidth = 1.8;
  ctx.lineCap = 'round';
  for (let f = -1; f <= 1; f++){
    ctx.beginPath();
    ctx.moveTo(fx, fy);
    ctx.lineTo(fx + side * 1.5, fy + f * 1.8 + 3);
    ctx.stroke();
  }
  // Pulso
  ctx.fillStyle = boneShade;
  ctx.beginPath();
  ctx.arc(fx, fy, 2, 0, 7);
  ctx.fill();
}

function drawTatteredCloak(ctx, s, breath, walk, boneShade){
  const hue = s.clothHue;
  const tatter = s.tatterSeed;

  ctx.save();
  // Capa atrás do corpo
  const cloakGrad = ctx.createLinearGradient(0, -45, 0, 5);
  cloakGrad.addColorStop(0, `hsla(${hue}, 45%, 30%, 0.9)`);
  cloakGrad.addColorStop(0.6, `hsla(${hue}, 50%, 22%, 0.85)`);
  cloakGrad.addColorStop(1, `hsla(${hue}, 55%, 15%, 0.7)`);
  ctx.fillStyle = cloakGrad;

  // Corpo da capa (trapézio irregular)
  const sway = Math.sin(time * 2 + s.breathPhase) * 1.5;
  ctx.beginPath();
  ctx.moveTo(-8, -42);
  ctx.lineTo(8, -42);
  ctx.lineTo(11 + sway, -20);
  // Bordas rasgadas inferiores
  ctx.lineTo(10 + sway, -12);
  ctx.lineTo(8 + sway, -6);
  ctx.lineTo(6 + sway, -14);
  ctx.lineTo(3 + sway, -8);
  ctx.lineTo(1 + sway, -16);
  ctx.lineTo(-2 + sway, -10);
  ctx.lineTo(-4 + sway, -15);
  ctx.lineTo(-6 + sway, -8);
  ctx.lineTo(-8 + sway, -14);
  ctx.lineTo(-11 + sway, -20);
  ctx.closePath();
  ctx.fill();

  // Dobras/brias
  ctx.strokeStyle = `hsla(${hue}, 60%, 12%, 0.6)`;
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(-4, -38);
  ctx.quadraticCurveTo(-2, -22, -3 + sway, -10);
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(5, -38);
  ctx.quadraticCurveTo(3, -22, 4 + sway, -10);
  ctx.stroke();

  // Runas brilhantes na capa (por tipo)
  if (s.type === 'mage' || s.type === 'guardian'){
    const runeGlow = 0.5 + 0.5 * Math.sin(time * 3 + s.runePhase);
    ctx.save();
    ctx.shadowColor = `hsl(${s.runeHue}, 100%, 65%)`;
    ctx.shadowBlur = 8 * runeGlow;
    ctx.strokeStyle = `hsla(${s.runeHue}, 100%, 75%, ${0.7})`;
    ctx.lineWidth = 1;
    // Símbolo rúnico simples
    ctx.beginPath();
    ctx.moveTo(-2, -34);
    ctx.lineTo(2, -34);
    ctx.moveTo(0, -36);
    ctx.lineTo(0, -30);
    ctx.moveTo(-2, -30);
    ctx.lineTo(2, -30);
    ctx.stroke();
    // Segundo símbolo
    ctx.beginPath();
    ctx.arc(5, -25, 2, 0, 7);
    ctx.moveTo(5, -27); ctx.lineTo(5, -23);
    ctx.stroke();
    ctx.restore();
  }

  // Gola/hood (capuz na altura dos ombros)
  ctx.fillStyle = `hsla(${hue}, 45%, 26%, 0.95)`;
  ctx.beginPath();
  ctx.moveTo(-9, -42);
  ctx.quadraticCurveTo(-12, -48, -6, -50);
  ctx.lineTo(6, -50);
  ctx.quadraticCurveTo(12, -48, 9, -42);
  ctx.quadraticCurveTo(4, -40, -4, -40);
  ctx.closePath();
  ctx.fill();

  // Sombra da gola
  ctx.fillStyle = 'rgba(0,0,0,0.35)';
  ctx.beginPath();
  ctx.moveTo(-9, -42);
  ctx.quadraticCurveTo(-6, -45, 0, -45);
  ctx.quadraticCurveTo(6, -45, 9, -42);
  ctx.quadraticCurveTo(0, -43, -9, -42);
  ctx.closePath();
  ctx.fill();

  ctx.restore();
}

function drawSkeletonWeapon(ctx, s, armSwing, bone, boneShade, boneHighlight){
  // Arma por tipo
  if (s.type === 'warrior'){
    // Espada curta enferrujada
    ctx.save();
    ctx.translate(13, -30 - armSwing);
    ctx.rotate(0.3 + Math.sin(time * 3 + s.runePhase) * 0.05);
    // Lâmina
    const bladeGrad = ctx.createLinearGradient(0, -2, 0, 2);
    bladeGrad.addColorStop(0, '#c8c0a8');
    bladeGrad.addColorStop(0.5, '#8a8068');
    bladeGrad.addColorStop(1, '#4a4030');
    ctx.fillStyle = bladeGrad;
    ctx.fillRect(0, -1.4, 20, 2.8);
    // Ponta
    ctx.beginPath();
    ctx.moveTo(20, -1.4);
    ctx.lineTo(24, 0);
    ctx.lineTo(20, 1.4);
    ctx.closePath();
    ctx.fill();
    // Guarda
    ctx.fillStyle = '#3a3020';
    ctx.fillRect(-2, -3.5, 3, 7);
    // Cabo
    ctx.fillStyle = '#5a4a30';
    ctx.fillRect(-8, -1, 6, 2);
    // Pombo
    ctx.fillStyle = '#7a6a40';
    ctx.beginPath();
    ctx.arc(-9, 0, 1.8, 0, 7);
    ctx.fill();
    // Brilho da lâmina
    ctx.strokeStyle = 'rgba(255,255,255,0.45)';
    ctx.lineWidth = 0.5;
    ctx.beginPath();
    ctx.moveTo(1, -0.7);
    ctx.lineTo(19, -0.7);
    ctx.stroke();
    // Ferrugem
    ctx.fillStyle = 'rgba(120,60,20,0.6)';
    ctx.beginPath();
    ctx.arc(8, 0.5, 1.2, 0, 7);
    ctx.arc(14, -0.5, 0.8, 0, 7);
    ctx.fill();
    ctx.restore();
  } else if (s.type === 'archer'){
    // Arco
    ctx.save();
    ctx.translate(-12, -28 + armSwing);
    ctx.rotate(-0.2);
    // Corpo do arco
    ctx.strokeStyle = '#6a4a28';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(0, 0, 14, -1.3, 1.3);
    ctx.stroke();
    // Corda
    ctx.strokeStyle = 'rgba(240,235,215,0.85)';
    ctx.lineWidth = 0.7;
    ctx.beginPath();
    ctx.moveTo(14 * Math.cos(-1.3), 14 * Math.sin(-1.3));
    ctx.lineTo(14 * Math.cos(1.3), 14 * Math.sin(1.3));
    ctx.stroke();
    // Detalhes do arco
    ctx.strokeStyle = '#4a3018';
    ctx.lineWidth = 0.8;
    ctx.beginPath();
    ctx.arc(0, 0, 13, -1.3, 1.3);
    ctx.stroke();
    ctx.restore();
  } else if (s.type === 'mage'){
    // Cajado com cristal
    ctx.save();
    ctx.translate(13, -30 - armSwing);
    ctx.rotate(0.15);
    // Haste
    ctx.strokeStyle = '#5a4028';
    ctx.lineWidth = 2.6;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(-8, 4);
    ctx.lineTo(8, -24);
    ctx.stroke();
    ctx.strokeStyle = '#8a6a44';
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(-7, 3);
    ctx.lineTo(8, -24);
    ctx.stroke();
    // Cristal no topo
    const crystalGlow = 0.6 + 0.4 * Math.sin(time * 4 + s.runePhase);
    ctx.save();
    ctx.translate(9, -26);
    ctx.shadowColor = `hsl(${s.runeHue}, 100%, 70%)`;
    ctx.shadowBlur = 14 * crystalGlow;
    ctx.fillStyle = `hsl(${s.runeHue}, 100%, 70%)`;
    ctx.beginPath();
    ctx.moveTo(0, -5);
    ctx.lineTo(2.5, 0);
    ctx.lineTo(0, 5);
    ctx.lineTo(-2.5, 0);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = `hsl(${s.runeHue}, 100%, 90%)`;
    ctx.beginPath();
    ctx.moveTo(0, -5);
    ctx.lineTo(2.5, 0);
    ctx.lineTo(0, 0);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
    ctx.restore();
  } else if (s.type === 'guardian'){
    // Machado grande
    ctx.save();
    ctx.translate(13, -30 - armSwing);
    ctx.rotate(0.25);
    // Haste
    ctx.strokeStyle = '#4a3820';
    ctx.lineWidth = 3.2;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(-6, 6);
    ctx.lineTo(10, -18);
    ctx.stroke();
    ctx.strokeStyle = '#7a5a34';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(-5, 5);
    ctx.lineTo(10, -18);
    ctx.stroke();
    // Cabeça do machado
    ctx.save();
    ctx.translate(10, -18);
    ctx.rotate(0.3);
    const axeGrad = ctx.createLinearGradient(-3, -8, 8, 8);
    axeGrad.addColorStop(0, '#d0d8e0');
    axeGrad.addColorStop(0.5, '#8a96a8');
    axeGrad.addColorStop(1, '#3a4454');
    ctx.fillStyle = axeGrad;
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.quadraticCurveTo(8, -10, 14, -8);
    ctx.lineTo(14, 4);
    ctx.quadraticCurveTo(8, 6, 0, 0);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = '#1a2028';
    ctx.lineWidth = 1;
    ctx.stroke();
    // Fio brilhante
    ctx.strokeStyle = 'rgba(255,255,255,0.7)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(3, -1);
    ctx.quadraticCurveTo(9, -8, 13, -7);
    ctx.stroke();
    ctx.restore();
    ctx.restore();
  }
}

/* =========================================================
   RENDER -- PROJÉTEIS
========================================================= */
function drawBolts(){
  for (const b of bolts){
    for (let i = 0; i < b.trail.length; i++){
      const t = b.trail[i];
      const a = (i / b.trail.length) * 0.6;
      ctx.globalAlpha = a;
      ctx.fillStyle = `hsl(${b.hue}, 100%, 70%)`;
      ctx.shadowColor = `hsl(${b.hue}, 100%, 65%)`;
      ctx.shadowBlur = 12;
      ctx.beginPath();
      ctx.arc(t.x, t.y, 2 + i * 0.7, 0, 7);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    ctx.shadowBlur = 0;

    ctx.save();
    ctx.shadowColor = '#b48cff';
    ctx.shadowBlur = 26;
    const g = ctx.createRadialGradient(b.x, b.y, 1, b.x, b.y, b.r * 2);
    g.addColorStop(0, '#ffffff');
    g.addColorStop(0.4, '#e8d9ff');
    g.addColorStop(1, `hsl(${b.hue}, 100%, 60%)`);
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(b.x, b.y, b.r * 1.4, 0, 7);
    ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(b.x, b.y, b.r * 0.5, 0, 7);
    ctx.fill();
    ctx.restore();

    ctx.strokeStyle = `hsla(${b.hue}, 100%, 80%, 0.85)`;
    ctx.lineWidth = 1.4;
    ctx.shadowColor = `hsl(${b.hue}, 100%, 70%)`;
    ctx.shadowBlur = 8;
    for (let k = 0; k < 3; k++){
      ctx.beginPath();
      const a0 = time * 20 + k * 2.1;
      ctx.moveTo(b.x + Math.cos(a0) * 8, b.y + Math.sin(a0) * 8);
      ctx.lineTo(b.x + Math.cos(a0 + 0.8) * 13, b.y + Math.sin(a0 + 0.8) * 13);
      ctx.lineTo(b.x + Math.cos(a0 + 1.6) * 7, b.y + Math.sin(a0 + 1.6) * 7);
      ctx.stroke();
    }
    ctx.shadowBlur = 0;
  }
}

