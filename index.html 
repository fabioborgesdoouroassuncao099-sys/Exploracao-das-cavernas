    ctx.translate(32, 16);
    ctx.rotate(ang);

    const trailGrad = ctx.createRadialGradient(0, 0, 10, 0, 0, 30);
    trailGrad.addColorStop(0, 'rgba(255,230,150,0)');
    trailGrad.addColorStop(0.6, 'rgba(255,220,140,0.35)');
    trailGrad.addColorStop(1, 'rgba(255,200,100,0)');
    ctx.strokeStyle = trailGrad;
    ctx.lineWidth = 14;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.arc(0, 0, 26, -1.15, 0.15);
